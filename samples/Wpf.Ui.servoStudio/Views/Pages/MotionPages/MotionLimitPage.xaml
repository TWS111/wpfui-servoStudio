<Page x:Name="page"
      x:Class="Wpf.Ui.servoStudio.Views.Pages.MotionPages.MotionLimitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="MotionLimitPage"
      d:DataContext="{d:DesignInstance local:MotionLimitPage,
                                       IsDesignTimeCreatable=False}"
      d:DesignHeight="700"
      d:DesignWidth="1000"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Width" Value="220" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="TextBlock" x:Key="UnitStyle">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style TargetType="ui:Card" x:Key="GroupCardStyle">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style TargetType="DockPanel" x:Key="RowStyle">
            <Setter Property="LastChildFill" Value="False" />
            <Setter Property="Margin" Value="8,0,8,8" />
        </Style>
    </Page.Resources>

    <Grid Width="{Binding ActualWidth, ElementName=page, Mode=OneWay}"
          Height="{Binding ActualHeight, ElementName=page, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部连接状态与全局操作 -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="运动限制参数 (CiA402 + H 变量)"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding ViewModel.ConnectionInfo}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0"
                               MinWidth="120"
                               Content="读取全部"
                               Appearance="Secondary"
                               Command="{Binding ViewModel.ReadAllParametersCommand}"
                               IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                    <ui:Button Margin="0,0,8,0"
                               MinWidth="120"
                               Content="下发全部"
                               Appearance="Primary"
                               Command="{Binding ViewModel.ApplyAllParametersCommand}" />
                    <ui:Button MinWidth="120"
                               Content="恢复默认"
                               Appearance="Caution"
                               Command="{Binding ViewModel.ResetToDefaultCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 极性 0x607E -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="极性设置 (0x607E)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Margin="8,0,24,0"
                                      Content="位置极性反向 (bit7)"
                                      IsChecked="{Binding ViewModel.PolarityPosition}" />
                            <CheckBox Margin="0,0,24,0"
                                      Content="速度极性反向 (bit6)"
                                      IsChecked="{Binding ViewModel.PolarityVelocity}" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ViewModel.PolarityRaw, StringFormat='Raw=0x{0:X2}'}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 转矩 / 电流限制 -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="转矩 / 电流限制"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大转矩 (0x6072)" />
                            <Slider Minimum="0" Maximum="1000" TickFrequency="100"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxTorque, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="65535"
                                           Value="{Binding ViewModel.MaxTorque}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="‰" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大电流 (0x6073)" />
                            <Slider Minimum="0" Maximum="1000" TickFrequency="100"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxCurrent, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="65535"
                                           Value="{Binding ViewModel.MaxCurrent}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="‰" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="电机额定转矩 (0x6076)" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           IsReadOnly="True"
                                           Value="{Binding ViewModel.MotorRatedTorque, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="mNm" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="正向转矩限制 (0x60E0)" />
                            <Slider Minimum="0" Maximum="1000" TickFrequency="100"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.PositiveTorqueLimit, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="65535"
                                           Value="{Binding ViewModel.PositiveTorqueLimit}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="‰" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="负向转矩限制 (0x60E1)" />
                            <Slider Minimum="0" Maximum="1000" TickFrequency="100"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.NegativeTorqueLimit, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="65535"
                                           Value="{Binding ViewModel.NegativeTorqueLimit}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="‰" />
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 速度 / 加减速 限制 -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="速度 / 加减速限制"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大轮廓速度 (0x607F)" />
                            <Slider Minimum="0" Maximum="10000" TickFrequency="1000"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxProfileVelocity, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="4294967295"
                                           Value="{Binding ViewModel.MaxProfileVelocity}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc/s" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大电机速度 (0x6080)" />
                            <Slider Minimum="0" Maximum="10000" TickFrequency="1000"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxMotorSpeed, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="4294967295"
                                           Value="{Binding ViewModel.MaxMotorSpeed}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="rpm" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大加速度 (0x60C5)" />
                            <Slider Minimum="0" Maximum="500000" TickFrequency="50000"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxAcceleration, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="4294967295"
                                           Value="{Binding ViewModel.MaxAcceleration}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc/s²" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="最大减速度 (0x60C6)" />
                            <Slider Minimum="0" Maximum="500000" TickFrequency="50000"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.MaxDeceleration, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="0" Maximum="4294967295"
                                           Value="{Binding ViewModel.MaxDeceleration}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc/s²" />
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 位置限制 -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="位置限制"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="软件位置下限 (0x607D-1)" />
                            <ui:NumberBox MinWidth="120" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="-2147483648" Maximum="2147483647"
                                           Value="{Binding ViewModel.MinSoftwarePosition}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="软件位置上限 (0x607D-2)" />
                            <ui:NumberBox MinWidth="120" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="-2147483648" Maximum="2147483647"
                                           Value="{Binding ViewModel.MaxSoftwarePosition}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="位置范围下限 (0x607B-1)" />
                            <ui:NumberBox MinWidth="120" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="-2147483648" Maximum="2147483647"
                                           Value="{Binding ViewModel.PositionRangeMin}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="位置范围上限 (0x607B-2)" />
                            <ui:NumberBox MinWidth="120" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="-2147483648" Maximum="2147483647"
                                           Value="{Binding ViewModel.PositionRangeMax}" />
                            <TextBlock Style="{StaticResource UnitStyle}" Text="inc" />
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 减速比 / 进给常数 -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="减速比 (0x6091) / 进给常数 (0x6092)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="减速比 - 电机圈数 (sub1)" />
                            <Slider Minimum="1" Maximum="100" TickFrequency="10"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.GearRatioMotorRev, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="1" Maximum="4294967295"
                                           Value="{Binding ViewModel.GearRatioMotorRev}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="减速比 - 轴圈数 (sub2)" />
                            <Slider Minimum="1" Maximum="100" TickFrequency="10"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.GearRatioShaftRev, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="1" Maximum="4294967295"
                                           Value="{Binding ViewModel.GearRatioShaftRev}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="进给常数 - feed (sub1)" />
                            <Slider Minimum="1" Maximum="1000" TickFrequency="100"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.FeedConstantFeed, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="1" Maximum="4294967295"
                                           Value="{Binding ViewModel.FeedConstantFeed}" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource RowStyle}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="进给常数 - 轴圈数 (sub2)" />
                            <Slider Minimum="1" Maximum="100" TickFrequency="10"
                                    Width="150" VerticalAlignment="Center"
                                    Value="{Binding ViewModel.FeedConstantShaftRev, Mode=TwoWay}" />
                            <ui:NumberBox MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           ClearButtonEnabled="False" SpinButtonPlacementMode="Compact"
                                           Minimum="1" Maximum="4294967295"
                                           Value="{Binding ViewModel.FeedConstantShaftRev}" />
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- H 变量限制 -->
                <ui:Card Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <TextBlock Text="H 变量保护 / 限制参数"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="36"
                                  ItemsSource="{Binding ViewModel.HLimitItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HIndex"
                                                    Binding="{Binding HIndex}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTextColumn Header="参数名"
                                                    Binding="{Binding ParameterName}"
                                                    IsReadOnly="True"
                                                    Width="*" />
                                <DataGridTextColumn Header="通讯地址"
                                                    Binding="{Binding CommAddress}"
                                                    IsReadOnly="True"
                                                    Width="100" />
                                <DataGridTextColumn Header="单位"
                                                    Binding="{Binding Unit}"
                                                    IsReadOnly="True"
                                                    Width="60" />
                                <DataGridTextColumn Header="最小"
                                                    Binding="{Binding MinValue}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTextColumn Header="最大"
                                                    Binding="{Binding MaxValue}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTextColumn Header="默认"
                                                    Binding="{Binding DefaultValue}"
                                                    IsReadOnly="True"
                                                    Width="80" />
                                <DataGridTemplateColumn Header="当前值" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:NumberBox Margin="2"
                                                          ClearButtonEnabled="False"
                                                          IsEnabled="{Binding IsEditable}"
                                                          SpinButtonPlacementMode="Hidden"
                                                          Value="{Binding CurrentValue, UpdateSourceTrigger=LostFocus}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Margin="2"
                                                           MinWidth="50"
                                                           Padding="8,2"
                                                           Content="读"
                                                           Appearance="Secondary"
                                                           Command="{Binding DataContext.ViewModel.ReadSingleHItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Margin="2"
                                                           MinWidth="50"
                                                           Padding="8,2"
                                                           Content="写"
                                                           Appearance="Primary"
                                                           IsEnabled="{Binding IsEditable}"
                                                           Command="{Binding DataContext.ViewModel.WriteSingleHItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态"
                                                    Binding="{Binding StatusText}"
                                                    IsReadOnly="True"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="14,10"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 Width="18" Height="18"
                                 Margin="0,0,12,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding ViewModel.OperationStatusText}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ViewModel.LastOperationText}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400" />
            </Grid>
        </Border>
    </Grid>
</Page>
