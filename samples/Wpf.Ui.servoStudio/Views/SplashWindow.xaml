<Window
    x:Class="Wpf.Ui.servoStudio.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ServoStudio"
    Width="480"
    Height="300"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border x:Name="RootBorder"
            Background="#F5F5FA"
            CornerRadius="16"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Direction="270"
                Opacity="0.5"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid Margin="48,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Icon + Title  -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="52"
                    Height="52"
                    Margin="0,0,14,0"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="pack://application:,,,/Assets/applicationIcon-256.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="Bold"
                        Text="ServoStudio" />
                    <TextBlock
                        x:Name="SubtitleText"
                        FontSize="11"
                        Text="EtherCAT Servo Drive Tool" />
                </StackPanel>
            </StackPanel>

            <!--  Divider  -->
            <Rectangle
                x:Name="Divider"
                Grid.Row="1"
                Height="1"
                Margin="0,20,0,0" />

            <!--  Status + Progress  -->
            <StackPanel
                Grid.Row="3"
                Margin="0,0,0,16"
                VerticalAlignment="Bottom">
                <TextBlock
                    x:Name="StatusText"
                    Margin="0,0,0,10"
                    FontSize="12"
                    Text="正在初始化..." />
                <ProgressBar
                    x:Name="LoadProgress"
                    Height="3"
                    BorderThickness="0"
                    Foreground="#4A9EFF"
                    Maximum="100"
                    Value="0" />
            </StackPanel>

            <!--  Version  -->
            <TextBlock
                x:Name="VersionText"
                Grid.Row="4"
                HorizontalAlignment="Center"
                FontSize="11" />

            <!--  Copyright  -->
            <TextBlock
                x:Name="CopyrightText"
                Grid.Row="5"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                FontSize="10"
                Text="© 2026 ServoStudio" />
        </Grid>
    </Border>
</Window>
