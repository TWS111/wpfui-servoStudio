<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ControlPage"
    d:DataContext="{d:DesignInstance local:ControlPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 位指示灯：激活=绿色圆点，未激活=灰色圆点 -->
        <Style x:Key="BitIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="Fill" Value="#55555555"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Fill" Value="#FF00CC66"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 位标签(中文) -->
        <Style x:Key="BitLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- 位标签(英文) -->
        <Style x:Key="BitLabelEn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <!-- 位编号 -->
        <Style x:Key="BitNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- 单列容器 -->
        <Style x:Key="BitColumn" TargetType="StackPanel">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- 连接状态栏 -->
            <Border Margin="0,0,0,16" Padding="14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ViewModel.ConnectionInfo}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="CiA402 状态: "/>
                        <Run Text="{Binding ViewModel.ParsedStateName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- ═══════ 状态字 (0x6041) ═══════ -->
            <ui:Card Margin="0,0,0,8" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="状态字 Statusword (0x6041)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ViewModel.StatusWordHex}" FontSize="16" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DockPanel>

                    <!-- 位 15→0 从左到右 -->
                    <Border Padding="2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <WrapPanel HorizontalAlignment="Center">
                            <!-- 高八位 Bits 15-8 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Bit 15 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="15"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit15}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 14 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="14"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit14}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 13 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="13"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit13}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关1"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 12 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="12"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit12}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关0"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 11 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="11"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit11}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="内部限位"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Internal Limit"/>
                            </StackPanel>
                            <!-- Bit 10 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="10"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit10}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="目标到达"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Target Reached"/>
                            </StackPanel>
                            <!-- Bit 9 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="9"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit9}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="远程"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Remote"/>
                            </StackPanel>
                            <!-- Bit 8 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="8"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit8}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            </StackPanel>
                            <!-- 高低八位分割线 -->
                            <Border Width="1" MinHeight="50" Margin="6,6,6,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <!-- 低八位 Bits 7-0 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Bit 7 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="7"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit7}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="警告"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Warning"/>
                            </StackPanel>
                            <!-- Bit 6 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="6"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit6}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="上电禁止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switch On Disabled"/>
                            </StackPanel>
                            <!-- Bit 5 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="5"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit5}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="快速停止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Quick Stop"/>
                            </StackPanel>
                            <!-- Bit 4 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="4"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit4}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="电压使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Voltage Enabled"/>
                            </StackPanel>
                            <!-- Bit 3 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="3"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit3}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="故障"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Fault"/>
                            </StackPanel>
                            <!-- Bit 2 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="2"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit2}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="运行使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Op Enabled"/>
                            </StackPanel>
                            <!-- Bit 1 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="1"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit1}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="已上电"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switched On"/>
                            </StackPanel>
                            <!-- Bit 0 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="0"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit0}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="就绪上电"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Ready To Switch On"/>
                            </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ═══════ 控制字 (0x6040) ═══════ -->
            <ui:Card Margin="0,0,0,8" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="控制字 Controlword (0x6040)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ViewModel.ControlWordHex}" FontSize="16" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DockPanel>

                    <!-- 位 15→0 可切换 CheckBox -->
                    <Border Padding="2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <WrapPanel HorizontalAlignment="Center">
                            <!-- 高八位 Bits 15-8 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Bit 15 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="15"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit15}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 14 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="14"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit14}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 13 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="13"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit13}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 12 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="12"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit12}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 11 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="11"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit11}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 10 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="10"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit10}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="保留"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Reserved"/>
                            </StackPanel>
                            <!-- Bit 9 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="9"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit9}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="保留"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Reserved"/>
                            </StackPanel>
                            <!-- Bit 8 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="8"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit8}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="暂停"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Halt"/>
                            </StackPanel>
                            </StackPanel>
                            <!-- 高低八位分割线 -->
                            <Border Width="1" MinHeight="50" Margin="6,6,6,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <!-- 低八位 Bits 7-0 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Bit 7 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="7"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit7}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="故障复位"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Fault Reset"/>
                            </StackPanel>
                            <!-- Bit 6 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="6"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit6}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关2"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 5 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="5"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit5}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关1"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 4 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="4"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit4}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关0"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 3 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="3"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit3}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="运行使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Enable Op"/>
                            </StackPanel>
                            <!-- Bit 2 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="2"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit2}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="快速停止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Quick Stop"/>
                            </StackPanel>
                            <!-- Bit 1 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="1"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit1}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="电压使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Enable Voltage"/>
                            </StackPanel>
                            <!-- Bit 0 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="0"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit0}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="合闸"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switch On"/>
                            </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- 写入按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                        <ui:Button Content="写入控制字" Command="{Binding ViewModel.WriteControlWordCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Margin="0,0,0,0" MinWidth="130" Height="34"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ═══════ 快捷命令 ═══════ -->
            <ui:Card Margin="0,0,0,16" Padding="18">
                <StackPanel>
                    <TextBlock Text="状态机快捷命令" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <WrapPanel HorizontalAlignment="Left">
                        <ui:Button Content="Shutdown"          Command="{Binding ViewModel.CmdShutdownCommand}"         Margin="0,0,8,8" MinWidth="130" Height="34" ToolTip="0x0006 → ReadyToSwitchOn"/>
                        <ui:Button Content="Switch On"         Command="{Binding ViewModel.CmdSwitchOnCommand}"         Margin="0,0,8,8" MinWidth="130" Height="34" ToolTip="0x0007 → SwitchedOn"/>
                        <ui:Button Content="Enable Operation"  Command="{Binding ViewModel.CmdEnableOperationCommand}"  Margin="0,0,8,8" MinWidth="150" Height="34" ToolTip="0x000F → OperationEnabled" Appearance="Primary"/>
                        <ui:Button Content="Disable Voltage"   Command="{Binding ViewModel.CmdDisableVoltageCommand}"   Margin="0,0,8,8" MinWidth="140" Height="34" ToolTip="0x0000 → SwitchOnDisabled"/>
                        <ui:Button Content="Quick Stop"        Command="{Binding ViewModel.CmdQuickStopCommand}"        Margin="0,0,8,8" MinWidth="120" Height="34" ToolTip="0x0002 → QuickStopActive" Appearance="Caution"/>
                        <ui:Button Content="Fault Reset"       Command="{Binding ViewModel.CmdFaultResetCommand}"       Margin="0,0,8,8" MinWidth="120" Height="34" ToolTip="0x0080 → FaultReset" Appearance="Danger"/>
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <!-- 状态栏 -->
            <Border Padding="12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="{Binding ViewModel.OperationStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
