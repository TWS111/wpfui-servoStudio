<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Wpf.Ui.servoStudio.Services"
    xmlns:pages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.DeviceSetPages"
    xmlns:hardwarePages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.HardwarePages"
    xmlns:motionPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
    xmlns:parametersPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FactoryPages"
    xmlns:firmwarePages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FirmwarePages"
    xmlns:appDataPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.AppDataPages"
    xmlns:tuningPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.TuningPages"
    Title="首页"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=False}"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d"
    PreviewMouseDown="Page_PreviewMouseDown">

    <Page.Resources>
        <Storyboard x:Key="CardMouseEnter">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.02" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.02" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="CardMouseLeave">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="DescFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="NavCardStyle" TargetType="ui:CardAction">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1.0" ScaleY="1.0"/></Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseEnter}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseLeave}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,14,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="CategoryCardStyle" TargetType="ui:CardAction">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1.0" ScaleY="1.0"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseEnter}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseLeave}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="420"/>
            <ColumnDefinition Width="3*" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧：可滚动功能区 ===== -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Padding="20,12,10,12">
            <StackPanel Margin="0,0,0,20">

                <!-- 标题 -->
                <TextBlock Text="GX Servo Studio" FontSize="28" FontWeight="Bold" Margin="4,4,0,2"/>
                <TextBlock Text="伺服驱动器调试与配置工具" FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,10"/>

                <!-- 设备状态横幅 -->
                <ui:Card Margin="0,4,0,4" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 状态圆形图标 -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsAnyConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="PlugDisconnected20"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsUsbConnected}" Value="True">
                                                <Setter Property="Symbol" Value="UsbStick20"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsAnyConnected}" Value="True">
                                                <Setter Property="Symbol" Value="PlugConnected24"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>

                        <!-- 状态文字 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="未连接设备"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsUsbConnected}" Value="True">
                                                <Setter Property="Text" Value="USB 设备已连接"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsAnyConnected}" Value="True">
                                                <Setter Property="Text" Value="设备已连接"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="请前往设备列表连接 EtherCAT / CANopen / Modbus 从站"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsUsbConnected}" Value="True">
                                                <Setter Property="Text" Value="已连接非控制协议栈，不支持 SDO / 寄存器访问"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsAnyConnected}" Value="True">
                                                <Setter Property="Text" Value="{Binding ViewModel.DeviceAdd.ActiveProtocol, StringFormat='协议栈：{0}'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 从站名称：根据协议栈分别显示 -->
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,1,0,0" FontWeight="SemiBold"
                                       Text="{Binding ViewModel.DeviceAdd.EthernetSlaveNameInfo, StringFormat='从站：{0}'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsEthernetConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,1,0,0" FontWeight="SemiBold"
                                       Text="{Binding ViewModel.DeviceAdd.ModbusSlaveNameInfo, StringFormat='从站：{0}'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsModbusConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,1,0,0" FontWeight="SemiBold"
                                       Text="{Binding ViewModel.DeviceAdd.CanopenSlaveNameInfo, StringFormat='从站：{0}'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsCanopenConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <ui:Button Grid.Column="2" Height="34" MinWidth="110" VerticalAlignment="Center"
                                   Command="{Binding ViewModel.NavigateToCommand}"
                                   CommandParameter="{x:Type pages:ListPage}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="连接设备"/>
                                    <Setter Property="Icon" Value="{ui:SymbolIcon Add20}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.DeviceAdd.IsAnyConnected}" Value="True">
                                            <Setter Property="Content" Value="查看详情"/>
                                            <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRight20}"/>
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </Grid>
                </ui:Card>

                <!-- ===== 功能分类入口 ===== -->
                <TextBlock Text="功能分类" Style="{StaticResource SectionHeader}"/>

                <!-- 设备与监控 -->
                <StackPanel x:Name="CategoryPanel0" Tag="0" Margin="10, 0, 10, 0 "
                            MouseEnter="CategoryPanel_MouseEnter"
                            MouseLeave="CategoryPanel_MouseLeave">
                    <ui:CardAction Style="{StaticResource CategoryCardStyle}"
                                   Tag="0" Click="CategoryCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                                    Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="设备与监控" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="设备列表、状态机、仪表盘、故障信息、总线诊断" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="5 项功能" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:SymbolIcon FontSize="14" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronRight20"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel, AncestorLevel=2}}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronDown20"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <Border x:Name="SubMenu0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1,0,1,1" CornerRadius="0,0,8,8"
                            Padding="8,4,8,8" Margin="0,-2,0,4"
                            MaxHeight="0" Opacity="0">
                        <StackPanel>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type pages:ListPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="PlugConnected24" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="设备列表" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="查看已连接设备并添加新设备" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type local:ControlPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DesktopCursor24" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="状态机" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="CiA402 状态机与控制字调试" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type local:DashboardPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Gauge24" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="仪表盘" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="设备状态实时监控面板" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type local:FaultInfoPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="故障信息" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="查看故障告警记录与诊断信息" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type pages:BusDiagnosticsPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Pulse20" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="总线诊断" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="实时监控总线质量与通信延迟" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 硬件与运动 -->
                <StackPanel x:Name="CategoryPanel1" Tag="1" Margin="10, 0, 10, 0 "
                            MouseEnter="CategoryPanel_MouseEnter"
                            MouseLeave="CategoryPanel_MouseLeave">
                    <ui:CardAction Style="{StaticResource CategoryCardStyle}"
                                   Tag="1" Click="CategoryCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10"
                                    Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <ui:SymbolIcon Symbol="DeveloperBoard16" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="硬件与运动" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="硬件总览、控制器参数、电机参数、IO配置、STO配置、控制模式、运动限制、运动曲线、多段速度/位置" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="9 项功能" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:SymbolIcon FontSize="14" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronRight20"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel, AncestorLevel=2}}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronDown20"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                    <Border x:Name="SubMenu1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1,0,1,1" CornerRadius="0,0,8,8"
                            Padding="8,4,8,8" Margin="0,-2,0,4"
                            MaxHeight="0" Opacity="0">
                        <StackPanel>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type local:HardwarePage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DeveloperBoard16" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="硬件总览" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="硬件配置状态概览" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type hardwarePages:ControllerPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DeveloperBoardLightning20" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="控制器参数" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="配置控制器硬件参数" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type hardwarePages:MotorPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync20" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="电机参数" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="配置电机额定参数与编码器设置" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type hardwarePages:IOPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSwap20" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="IO配置" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="输入输出端口逻辑配置" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                            </ui:CardAction>
                            <ui:CardAction Margin="0,4,0,0" Padding="10,8" Command="{Binding ViewModel.NavigateToCommand}" CommandParameter="{x:Type hardwarePages:StoConfigPage}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldLock20" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
