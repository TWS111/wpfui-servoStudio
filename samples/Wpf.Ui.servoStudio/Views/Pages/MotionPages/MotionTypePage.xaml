                                <Border Margin="0,10,0,0" Padding="10" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="测试模式:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.CspTestModeEnabled, Mode=TwoWay}"
                                                             OnContent="已启用" OffContent="已关闭" VerticalAlignment="Center"/>
                                            <TextBlock Text="位置步长:" VerticalAlignment="Center" Margin="20,0,8,0"/>
                                            <ui:NumberBox Value="{Binding ViewModel.CspTestPositionStep, UpdateSourceTrigger=PropertyChanged}"
                                                          Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0"
                                                          SmallChange="10" LargeChange="1000" MinWidth="140" Height="34"/>
                                            <TextBlock Text="counts/周期" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </WrapPanel>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="启用后，每个周期发送前主站会在当前目标位置上累加上述步长，用于平稳移动/仿真测试。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- CSV 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsCsvVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="周期同步速度参数 (CSV)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 速度前馈 0x60B1 — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="速度前馈 [0x60B1]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvVelocityOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvVelocityOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩前馈 0x60B2 — INT16 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩前馈 [0x60B2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvTorqueOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvTorqueOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Margin="0,8,0,12" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="厂商自定义 H08 速度环 / H06 速度曲线参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H08.00 速度环增益1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CsvH08SpeedKp1, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H08.01 速度环积分1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CsvH08SpeedKi1, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.05 加速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CsvH06AccTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.06 减速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CsvH06DecTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,6,0,0" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="周期 PDO 下发（主站→从站）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="发送周期:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:NumberBox Value="{Binding ViewModel.CyclicSendIntervalMs, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1000" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10" MinWidth="120" Height="34"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:Button Content="启动周期发送" Command="{Binding ViewModel.StartCyclicSendCommand}" Appearance="Primary" Height="34" Margin="0,0,8,0"/>
                                    <ui:Button Content="停止" Command="{Binding ViewModel.StopCyclicSendCommand}" Appearance="Secondary" Height="34"/>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ViewModel.CyclicSendCycleCountDisplay, StringFormat=已发送帧数: {0}}"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding ViewModel.CyclicSendLastError}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- CST 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsCstVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="周期同步转矩参数 (CST)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标转矩 0x6071 — INT16 (千分比 ‰) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标转矩 [0x6071]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstTargetTorque, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstTargetTorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩前馈 0x60B2 — INT16 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩前馈 [0x60B2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstTorqueOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstTorqueOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Margin="0,8,0,12" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="厂商自定义 H07 转矩限制 / H0F 速度限位参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H07.09 正内部转矩限制(A)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CstH07TorqueLimitPos, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H07.10 负内部转矩限制(A)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CstH07TorqueLimitNeg, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H0F.20 正向速度限制(rpm)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CstH0fSpeedLimitPos, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H0F.21 负向速度限制(rpm)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CstH0fSpeedLimitNeg, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H0F.22 速度限制使能" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.CstH0fSpeedLimitEn, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,6,0,0" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="周期 PDO 下发（主站→从站）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="发送周期:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:NumberBox Value="{Binding ViewModel.CyclicSendIntervalMs, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="1000" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10" MinWidth="120" Height="34"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,14,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:Button Content="启动周期发送" Command="{Binding ViewModel.StartCyclicSendCommand}" Appearance="Primary" Height="34" Margin="0,0,8,0"/>
                                    <ui:Button Content="停止" Command="{Binding ViewModel.StopCyclicSendCommand}" Appearance="Secondary" Height="34"/>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ViewModel.CyclicSendCycleCountDisplay, StringFormat=已发送帧数: {0}}"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding ViewModel.CyclicSendLastError}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部应用按钮 -->
        <Border Grid.Row="2" Margin="0,0,0,0" Padding="15" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="下发参数配置" Command="{Binding ViewModel.ApplyParametersCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Width="150" Height="36"/>
                </StackPanel>
                <TextBlock Text="{Binding ViewModel.OperationStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

    </Grid>
</Page>
