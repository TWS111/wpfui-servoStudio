<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.AppDataPages.DataViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.AppDataPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DataViewPage"
    d:DataContext="{d:DesignInstance local:DataViewPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="18,8,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="数据导入 / 查看" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.CurrentFileName}" />
        </StackPanel>

        <!-- Row 1: 工具栏 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <ui:Button
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Appearance="Primary"
                    Command="{Binding ViewModel.LoadFileCommand}"
                    Content="导入文件"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Command="{Binding ViewModel.ReloadCommand}"
                    Content="重新加载"
                    Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button
                    Margin="0,0,16,0"
                    Padding="8,4"
                    Command="{Binding ViewModel.ClearCommand}"
                    Content="清空"
                    Icon="{ui:SymbolIcon Dismiss24}" />

                <ui:Button
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Command="{Binding ViewModel.CancelLoadCommand}"
                    Content="取消"
                    Icon="{ui:SymbolIcon Stop24}"
                    Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ProgressBar
                    Width="220"
                    Height="6"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding ViewModel.LoadProgress, Mode=OneWay}"
                    Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border
                    Width="1"
                    Height="20"
                    Margin="0,0,12,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- 波形外观控制：深/浅主题切换 + 图例字号 +/- -->
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="8,4"
                    Click="OnToggleTheme"
                    Content="深/浅"
                    Icon="{ui:SymbolIcon DarkTheme24}"
                    ToolTip="切换波形图深色 / 浅色背景" />
                <ui:Button
                    MinWidth="0"
                    Margin="0,0,2,0"
                    Padding="6,4"
                    Click="OnLegendFontDec"
                    Content="A-"
                    ToolTip="减小图例字号" />
                <ui:Button
                    MinWidth="0"
                    Margin="0,0,12,0"
                    Padding="6,4"
                    Click="OnLegendFontInc"
                    Content="A+"
                    ToolTip="增大图例字号" />

                <Border
                    Width="1"
                    Height="20"
                    Margin="0,0,12,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <ui:Button
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Command="{Binding ViewModel.SelectAllCommand}"
                    Content="全部显示" />
                <ui:Button
                    Margin="0,0,16,0"
                    Padding="8,4"
                    Command="{Binding ViewModel.UnselectAllCommand}"
                    Content="全部隐藏" />

                <Border
                    Width="1"
                    Height="20"
                    Margin="0,0,12,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding ViewModel.TotalChannels, StringFormat=通道:{0}}" />
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding ViewModel.TotalSamples, StringFormat=样本:{0}}" />
            </WrapPanel>
        </Border>

        <!-- Row 2: 主显示区 (左:通道列表, 右:波形窗) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 通道列表 (示波器风格按钮) -->
            <Border
                Grid.Column="0"
                Padding="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="4,2,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="通道 (按钮切换)" />
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.Channels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,0,4"
                                        Padding="8,6"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{Binding ColorHex}"
                                        BorderThickness="2"
                                        Command="{Binding DataContext.ViewModel.ToggleChannelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        IsEnabled="{Binding IsPlottable}"
                                        ToolTip="点击切换通道显示 / 关闭（字符串等非数值类型不可绘制）">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 通道色块 + CHx 标签 -->
                                            <Border
                                                Grid.Column="0"
                                                MinWidth="34"
                                                Margin="0,0,8,0"
                                                Padding="4,1"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorHex}"
                                                CornerRadius="3">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="Black"
                                                    Text="{Binding ChannelLabel}" />
                                            </Border>
                                            <!-- 变量名 / 分类 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="Medium"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Group}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <!-- ON/OFF 指示 + 样本数 -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="OFF" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                    <Setter Property="Text" Value="ON" />
                                                                    <Setter Property="Foreground" Value="{Binding ColorHex}" />
                                                                </DataTrigger>
                                                                <!-- 非数值（字符串等）类型显示数据类型而非 ON/OFF -->
                                                                <DataTrigger Binding="{Binding IsPlottable}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding DataType}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Count, StringFormat='N {0}'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <!-- 波形窗 -->
            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <scottplot:WpfPlot x:Name="Plot" />
            </Border>
        </Grid>

        <!-- Row 3: 状态栏 -->
        <Border
            Grid.Row="3"
            Margin="0,8,0,0"
            Padding="12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.CurrentFilePath}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding ViewModel.StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Page>
