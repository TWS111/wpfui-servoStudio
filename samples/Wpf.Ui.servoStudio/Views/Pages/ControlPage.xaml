 <Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ControlPage"
    d:DataContext="{d:DesignInstance local:ControlPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 位指示灯：激活=绿色圆点，未激活=主题自适应(亮色灰/暗色#252525) -->
        <Style x:Key="BitIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="Fill" Value="{DynamicResource BitIndicatorOffBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Fill" Value="#FF00CC66"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>        <!-- 位标签(中文) -->
        <Style x:Key="BitLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- 位标签(英文) -->
        <Style x:Key="BitLabelEn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <!-- 位编号 -->
        <Style x:Key="BitNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- 单列容器 -->
        <Style x:Key="BitColumn" TargetType="StackPanel">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════ CiA402 状态机图 相关样式 ═══════ -->
        <!-- 状态框基础样式 -->
        <Style x:Key="SmStateBox" TargetType="Border">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="MinWidth" Value="230"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 状态标题(中文) -->
        <Style x:Key="SmStateTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- 状态标题(英文) -->
        <Style x:Key="SmStateTitleEn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <!-- 转换按钮(ui:Button) -->
        <Style x:Key="SmTransBtn" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="158"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 箭头指示标签 -->
        <Style x:Key="SmArrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 转换编号标签 T1/T2… -->
        <Style x:Key="SmTransTag" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- 连接状态栏 -->
            <Border Margin="0,0,0,16" Padding="14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ViewModel.ConnectionInfo}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="CiA402 状态: "/>
                        <Run Text="{Binding ViewModel.ParsedStateName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- ═══════ 状态字 (0x6041) ═══════ -->
            <ui:Card Margin="0,0,0,8" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="状态字 Statusword (0x6041)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ViewModel.StatusWordHex}" FontSize="16" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DockPanel>

                    <!-- 位 15→0 从左到右 -->
                    <Border Padding="2" CornerRadius="4">
                        <WrapPanel HorizontalAlignment="Center">
                            <!-- 高八位 Bits 15-8 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Bit 15 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="15"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit15}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 14 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="14"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit14}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 13 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="13"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit13}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关1"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 12 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="12"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit12}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关0"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 11 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="11"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit11}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="内部限位"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Internal Limit"/>
                            </StackPanel>
                            <!-- Bit 10 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="10"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit10}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="目标到达"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Target Reached"/>
                            </StackPanel>
                            <!-- Bit 9 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="9"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit9}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="远程"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Remote"/>
                            </StackPanel>
                            <!-- Bit 8 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="8"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit8}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            </StackPanel>
                            <!-- 高低八位分割线 -->
                            <Border Width="1" MinHeight="50" Margin="6,6,6,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <!-- 低八位 Bits 7-0 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Bit 7 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="7"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit7}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="警告"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Warning"/>
                            </StackPanel>
                            <!-- Bit 6 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="6"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit6}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="上电禁止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switch On Disabled"/>
                            </StackPanel>
                            <!-- Bit 5 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="5"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit5}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="快速停止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Quick Stop"/>
                            </StackPanel>
                            <!-- Bit 4 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="4"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit4}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="电压使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Voltage Enabled"/>
                            </StackPanel>
                            <!-- Bit 3 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="3"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit3}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="故障"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Fault"/>
                            </StackPanel>
                            <!-- Bit 2 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="2"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit2}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="运行使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Op Enabled"/>
                            </StackPanel>
                            <!-- Bit 1 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="1"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit1}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="已上电"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switched On"/>
                            </StackPanel>
                            <!-- Bit 0 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="0"/>
                                <Ellipse Style="{StaticResource BitIndicator}" DataContext="{Binding ViewModel.SwBit0}"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="就绪上电"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Ready To Switch On"/>
                            </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- ═══════ 控制字 (0x6040) ═══════ -->
            <ui:Card Margin="0,0,0,8" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="控制字 Controlword (0x6040)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ViewModel.ControlWordHex}" FontSize="16" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DockPanel>

                    <!-- 位 15→0 可切换 CheckBox -->
                    <Border Padding="2" CornerRadius="4">
                        <WrapPanel HorizontalAlignment="Center">
                            <!-- 高八位 Bits 15-8 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Bit 15 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="15"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit15}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 14 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="14"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit14}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 13 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="13"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit13}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 12 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="12"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit12}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 11 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="11"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit11}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="厂商"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mfr Specific"/>
                            </StackPanel>
                            <!-- Bit 10 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="10"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit10}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="保留"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Reserved"/>
                            </StackPanel>
                            <!-- Bit 9 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="9"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit9}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="保留"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Reserved"/>
                            </StackPanel>
                            <!-- Bit 8 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="8"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit8}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="暂停"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Halt"/>
                            </StackPanel>
                            </StackPanel>
                            <!-- 高低八位分割线 -->
                            <Border Width="1" MinHeight="50" Margin="6,6,6,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <!-- 低八位 Bits 7-0 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <!-- Bit 7 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="7"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit7}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="故障复位"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Fault Reset"/>
                            </StackPanel>
                            <!-- Bit 6 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="6"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit6}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关2"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 5 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="5"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit5}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关1"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 4 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="4"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit4}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="模式相关0"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Mode Specific"/>
                            </StackPanel>
                            <!-- Bit 3 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="3"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit3}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="运行使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Enable Op"/>
                            </StackPanel>
                            <!-- Bit 2 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="2"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit2}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="快速停止"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Quick Stop"/>
                            </StackPanel>
                            <!-- Bit 1 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="1"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit1}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="电压使能"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Enable Voltage"/>
                            </StackPanel>
                            <!-- Bit 0 -->
                            <StackPanel Style="{StaticResource BitColumn}">
                                <TextBlock Style="{StaticResource BitNumber}" Text="0"/>
                                <CheckBox IsChecked="{Binding ViewModel.CwBit0}" HorizontalAlignment="Center" MinWidth="0"/>
                                <TextBlock Style="{StaticResource BitLabel}" Text="合闸"/>
                                <TextBlock Style="{StaticResource BitLabelEn}" Text="Switch On"/>
                            </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- 编辑提示 & 写入/放弃按钮 -->
                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4"
                            Visibility="{Binding ViewModel.IsEditingControlWord, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <SolidColorBrush Color="#FF9800" Opacity="0.12"/>
                        </Border.Background>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ui:Button Content="写入控制字" Command="{Binding ViewModel.WriteControlWordCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Margin="0,0,6,0" MinWidth="130" Height="34"/>
                                <ui:Button Content="放弃编辑" Command="{Binding ViewModel.DiscardEditCommand}" Appearance="Secondary" Icon="{ui:SymbolIcon Dismiss24}" MinWidth="100" Height="34"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#FF9800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="控制字已修改，刷新已暂停 — 请写入或放弃" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 未编辑时的写入按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsEditingControlWord}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Content="写入控制字" Command="{Binding ViewModel.WriteControlWordCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" MinWidth="130" Height="34"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ═══════ CiA402 状态机图 ═══════ -->
            <ui:Card Margin="0,0,0,16" Padding="18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="CiA402 状态机 State Machine" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Content="一键伺服使能"
                                   Command="{Binding ViewModel.CmdQuickEnableCommand}"
                                   Appearance="Success"
                                   Icon="{ui:SymbolIcon Play24}"
                                   ToolTip="自动执行 FaultReset → Shutdown → SwitchOn → EnableOperation 完整上电序列"
                                   MinWidth="170" Height="38" FontWeight="SemiBold"/>
                    </DockPanel>

                    <!-- 状态机 Grid：主链 (列0) ─ 连接器 (列1) ─ 侧支 (列2) -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 0: Switch On Disabled -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: T2↓ / T7↑ -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: Ready To Switch On -->
                            <RowDefinition Height="Auto"/>
                            <!-- 3: T3↓ / T6↑ -->
                            <RowDefinition Height="Auto"/>
                            <!-- 4: Switched On -->
                            <RowDefinition Height="Auto"/>
                            <!-- 5: T4↓ / T5↑ -->
                            <RowDefinition Height="Auto"/>
                            <!-- 6: Operation Enabled -->
                        </Grid.RowDefinitions>

                        <!-- ═══ 行0: Switch On Disabled (主链) + Fault (侧支) ═══ -->
                        <Border Grid.Row="0" Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="SwitchOnDisabled">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="上电禁止"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Switch On Disabled"/>
                            </StackPanel>
                        </Border>

                        <!-- 连接器：Switch On Disabled ──► Fault (双向) -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SmArrow}" Text="◄───────"/>
                            <TextBlock Style="{StaticResource SmTransTag}" Text="T15 Fault Reset"/>
                        </StackPanel>

                        <!-- Fault 状态框 -->
                        <Border Grid.Row="0" Grid.Column="2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="Fault">
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="FaultReactionActive">
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="故障"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Fault"/>
                                <ui:Button Style="{StaticResource SmTransBtn}" Margin="4,8,4,0"
                                           Command="{Binding ViewModel.CmdFaultResetCommand}"
                                           Appearance="Danger"
                                           Icon="{ui:SymbolIcon ArrowReset24}"
                                           Content="Fault Reset (T15)"
                                           ToolTip="0x0080 故障复位 → Switch On Disabled"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 行1: T2 Shutdown ↓  /  T7 Disable Voltage ↑ ═══ -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                            <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource SmArrow}" Text="▼"/>
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdShutdownCommand}"
                                           Content="Shutdown (T2)"
                                           Icon="{ui:SymbolIcon ArrowDown24}"
                                           ToolTip="0x0006 关断 → Ready To Switch On"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdDisableVoltageCommand}"
                                           Content="Disable Voltage (T7)"
                                           Icon="{ui:SymbolIcon ArrowUp24}"
                                           ToolTip="0x0000 禁止电压 → Switch On Disabled"/>
                                <TextBlock Style="{StaticResource SmArrow}" Text="▲"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ═══ 行2: Ready To Switch On ═══ -->
                        <Border Grid.Row="2" Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="ReadyToSwitchOn">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="准备上电"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Ready To Switch On"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 行3: T3 Switch On ↓ / T6 Shutdown ↑ ═══ -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                            <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource SmArrow}" Text="▼"/>
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdSwitchOnCommand}"
                                           Content="Switch On (T3)"
                                           Icon="{ui:SymbolIcon ArrowDown24}"
                                           ToolTip="0x0007 上电 → Switched On"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdShutdownCommand}"
                                           Content="Shutdown (T6)"
                                           Icon="{ui:SymbolIcon ArrowUp24}"
                                           ToolTip="0x0006 关断 → Ready To Switch On"/>
                                <TextBlock Style="{StaticResource SmArrow}" Text="▲"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ═══ 行4: Switched On ═══ -->
                        <Border Grid.Row="4" Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="SwitchedOn">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="已上电"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Switched On"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 行5: T4 Enable Operation ↓ / T5 Disable Operation ↑ ═══ -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                            <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource SmArrow}" Text="▼"/>
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdEnableOperationCommand}"
                                           Appearance="Primary"
                                           Content="Enable Op (T4)"
                                           Icon="{ui:SymbolIcon ArrowDown24}"
                                           ToolTip="0x000F 运行使能 → Operation Enabled"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                                <ui:Button Style="{StaticResource SmTransBtn}"
                                           Command="{Binding ViewModel.CmdDisableOperationCommand}"
                                           Content="Disable Op (T5)"
                                           Icon="{ui:SymbolIcon ArrowUp24}"
                                           ToolTip="0x0007 禁止运行 → Switched On"/>
                                <TextBlock Style="{StaticResource SmArrow}" Text="▲"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ═══ 行6: Operation Enabled (主链) + 连接器 + Quick Stop Active (侧支) ═══ -->
                        <Border Grid.Row="6" Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="OperationEnabled">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="运行使能"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Operation Enabled"/>
                            </StackPanel>
                        </Border>

                        <!-- 连接器：Operation Enabled ──T11 Quick Stop──► Quick Stop Active -->
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Style="{StaticResource SmArrow}" Text="───────►"/>
                            <TextBlock Style="{StaticResource SmTransTag}" Text="T11 Quick Stop"/>
                        </StackPanel>

                        <!-- Quick Stop Active 状态框 -->
                        <Border Grid.Row="6" Grid.Column="2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SmStateBox}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.ParsedStateName}" Value="QuickStopActive">
                                            <Setter Property="BorderThickness" Value="2.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmStateTitle}" Text="快速停止中"/>
                                <TextBlock Style="{StaticResource SmStateTitleEn}" Text="Quick Stop Active"/>
                                <ui:Button Style="{StaticResource SmTransBtn}" Margin="4,8,4,0"
                                           Command="{Binding ViewModel.CmdQuickStopCommand}"
                                           Appearance="Caution"
                                           Icon="{ui:SymbolIcon Stop24}"
                                           Content="Quick Stop (T11)"
                                           ToolTip="0x0002 紧急制动 → Quick Stop Active"/>
                                <ui:Button Style="{StaticResource SmTransBtn}" Margin="4,4,4,0"
                                           Command="{Binding ViewModel.CmdDisableVoltageCommand}"
                                           Content="Disable Voltage (T12)"
                                           Icon="{ui:SymbolIcon ArrowExportUp24}"
                                           ToolTip="0x0000 → Switch On Disabled"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 图例 -->
                    <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="4"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                        BorderThickness="2" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                <TextBlock Text="当前状态 Current" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                        BorderThickness="1.5" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"/>
                                <TextBlock Text="停止分支 Quick Stop" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                        BorderThickness="1.5" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                <TextBlock Text="故障分支 Fault" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Tx = CiA402 状态机转换编号" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- 状态栏 -->
            <Border Padding="12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="{Binding ViewModel.OperationStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
