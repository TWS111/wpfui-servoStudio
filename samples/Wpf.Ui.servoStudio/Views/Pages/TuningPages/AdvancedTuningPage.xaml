<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.TuningPages.AdvancedTuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.TuningPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="高级整定"
    d:DataContext="{d:DesignInstance local:AdvancedTuningPage,IsDesignTimeCreatable=False}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="20" FontWeight="Medium" Text="高级整定 (H09)" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="自调谐 / 陷波滤波器 / 低频振动抑制。修改后请点击“写入”，并在“辅助命令”中执行参数存储。" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Content="读取" Command="{Binding ViewModel.ReadAllCommand}" />
                <ui:Button Margin="0,0,12,0" Appearance="Primary" Content="写入" Command="{Binding ViewModel.WriteAllCommand}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.StatusText}" />
            </StackPanel>

            <ui:Card Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="自调谐基本 (H09.00 ~ H09.10)" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="H09.00 自调谐模式:" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4"
                                  SelectedIndex="{Binding ViewModel.AutoTuningMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="0 - 手动" />
                            <ComboBoxItem Content="1 - 标准自调谐" />
                            <ComboBoxItem Content="2 - 定位自调谐" />
                            <ComboBoxItem Content="3 - 实时自调谐" />
                        </ComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="H09.01 刚性等级 (0~31):" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="4" Margin="0,4,0,4" Minimum="0" Maximum="31"
                                      ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.StiffnessLevel, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="H09.02 负载惯量比 (%):" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Minimum="0" Maximum="65535"
                                      ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.InertiaRatio, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="H09.03 惯量辨识使能:" />
                        <CheckBox Grid.Row="1" Grid.Column="4" Margin="0,4,0,4" Content="启用辨识"
                                  IsChecked="{Binding ViewModel.InertiaIdentEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="H09.10 振动频率检测:" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Text="{Binding ViewModel.VibFreqDetect}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Hz (只读)" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="陷波滤波器 (H09.12 ~ H09.19)" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="陷波1 频率(Hz):" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" Minimum="0" Maximum="5000" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchFreq1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="深度(0~99):" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="4" Margin="0,4,0,4" Minimum="0" Maximum="99" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchDepth1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="6" Margin="0,4,8,4" VerticalAlignment="Center" Text="带宽:" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="7" Margin="0,4,0,4" Minimum="0" Maximum="10" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchBW1, UpdateSourceTrigger=LostFocus}" />
                        <CheckBox Grid.Row="0" Grid.Column="9" Margin="0,4,0,4" Content="启用陷波1" IsChecked="{Binding ViewModel.NotchEnabled1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="陷波2 频率(Hz):" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Minimum="0" Maximum="5000" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchFreq2, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="深度(0~99):" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="4" Margin="0,4,0,4" Minimum="0" Maximum="99" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchDepth2, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="6" Margin="0,4,8,4" VerticalAlignment="Center" Text="带宽:" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="7" Margin="0,4,0,4" Minimum="0" Maximum="10" ClearButtonEnabled="False" Value="{Binding ViewModel.NotchBW2, UpdateSourceTrigger=LostFocus}" />
                        <CheckBox Grid.Row="1" Grid.Column="9" Margin="0,4,0,4" Content="启用陷波2" IsChecked="{Binding ViewModel.NotchEnabled2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="低频振动抑制 (H09.30 ~ H09.33)" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="抑制1 频率(0.1Hz):" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" Minimum="0" Maximum="500" ClearButtonEnabled="False" Value="{Binding ViewModel.LowVibFreq1, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="幅值(0~100):" />
                        <ui:NumberBox Grid.Row="0" Grid.Column="4" Margin="0,4,0,4" Minimum="0" Maximum="100" ClearButtonEnabled="False" Value="{Binding ViewModel.LowVibAmp1, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,8,4" VerticalAlignment="Center" Text="抑制2 频率(0.1Hz):" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Minimum="0" Maximum="500" ClearButtonEnabled="False" Value="{Binding ViewModel.LowVibFreq2, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,8,4" VerticalAlignment="Center" Text="幅值(0~100):" />
                        <ui:NumberBox Grid.Row="1" Grid.Column="4" Margin="0,4,0,4" Minimum="0" Maximum="100" ClearButtonEnabled="False" Value="{Binding ViewModel.LowVibAmp2, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
