<Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.FactoryPages.FactoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FactoryPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FactoryPage"
    d:DataContext="{d:DesignInstance local:FactoryPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="FactoryContentRoot" Margin="16">
            <TabControl>
                <!-- ════════════════ EtherCAT ════════════════ -->
                <TabItem Header="EtherCAT 协议栈">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Text="{Binding ViewModel.EthercatStatus}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Content="全部读取"
                                       Icon="ArrowSync24"
                                       Command="{Binding ViewModel.ReadAllEcatCommand}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ViewModel.EtherCatRegisters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="140"/>
                                <DataGridTextColumn Header="Index" Binding="{Binding IndexHex}" Width="80"/>
                                <DataGridTextColumn Header="Sub" Binding="{Binding SubIndexHex}" Width="60"/>
                                <DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="数据类型" Binding="{Binding DataTypeText}" Width="100"/>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="160"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160"/>
                                <DataGridTemplateColumn Header="读" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="读"
                                                    Command="{Binding DataContext.ViewModel.ReadOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="禁用" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsDisabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ════════════════ CANopen ════════════════ -->
                <TabItem Header="CANopen 协议栈">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Text="{Binding ViewModel.CanopenStatus}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Content="全部读取"
                                       Icon="ArrowSync24"
                                       Command="{Binding ViewModel.ReadAllCanopenCommand}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ViewModel.CanOpenRegisters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="140"/>
                                <DataGridTextColumn Header="Index" Binding="{Binding IndexHex}" Width="80"/>
                                <DataGridTextColumn Header="Sub" Binding="{Binding SubIndexHex}" Width="60"/>
                                <DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="数据类型" Binding="{Binding DataTypeText}" Width="100"/>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="160"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160"/>
                                <DataGridTemplateColumn Header="读" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="读"
                                                    Command="{Binding DataContext.ViewModel.ReadOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="禁用" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsDisabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ════════════════ Modbus ════════════════ -->
                <TabItem Header="Modbus 协议栈">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                       Text="{Binding ViewModel.ModbusStatus}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Content="全部读取"
                                       Icon="ArrowSync24"
                                       Command="{Binding ViewModel.ReadAllModbusCommand}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ViewModel.ModbusRegisters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="120"/>
                                <DataGridTextColumn Header="Index" Binding="{Binding IndexHex}" Width="80"/>
                                <DataGridTextColumn Header="Sub" Binding="{Binding SubIndexHex}" Width="60"/>
                                <DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="数据类型" Binding="{Binding DataTypeText}" Width="100"/>
                                <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="140"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140"/>
                                <DataGridTemplateColumn Header="读" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="读"
                                                    Command="{Binding DataContext.ViewModel.ReadOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="禁用" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsDisabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 未解锁厂家权限时的遮罩，阻止查看和交互 -->
        <Border x:Name="FactoryLockOverlay"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="1"
                Visibility="Collapsed"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LockClosed24"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="此页内容需要厂家权限"/>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="请先到“设置”页输入正确的厂家密码解锁"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
