<Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.FactoryPages.AutomationProcessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FactoryPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AutomationProcessPage"
    d:DataContext="{d:DesignInstance local:AutomationProcessPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 测试结果状态徽章：依据 StateText 切换不同颜色。
             文字使用主题感知色，背景为半透明色叠加在主题底色之上，
             以保证在亮 / 暗主题下均可读。 -->
        <Style x:Key="ResultBadge" TargetType="Border">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <!-- 默认（未测）：灰 -->
            <Setter Property="Background" Value="#339E9E9E"/>
            <Setter Property="BorderBrush" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateText}" Value="进行中">
                    <Setter Property="Background" Value="#332196F3"/>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateText}" Value="合格">
                    <Setter Property="Background" Value="#334CAF50"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateText}" Value="不合格">
                    <Setter Property="Background" Value="#33F44336"/>
                    <Setter Property="BorderBrush" Value="#F44336"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateText}" Value="超时">
                    <Setter Property="Background" Value="#33FF9800"/>
                    <Setter Property="BorderBrush" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateText}" Value="不可用">
                    <Setter Property="Background" Value="#33757575"/>
                    <Setter Property="BorderBrush" Value="#757575"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 单个测试项行模板 -->
        <DataTemplate x:Key="TestItemTemplate">
            <Border Margin="0,4"
                    Padding="12,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 名称 + 说明 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Description}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Detail}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 耗时 -->
                    <TextBlock Grid.Column="1"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding DurationMs, StringFormat={}{0:F0} ms}"/>

                    <!-- 状态徽章 -->
                    <Border Grid.Column="2"
                            Margin="8,0"
                            Style="{StaticResource ResultBadge}">
                        <TextBlock HorizontalAlignment="Center"
                                   Text="{Binding StateText}"/>
                    </Border>

                    <!-- 单项执行 -->
                    <ui:Button Grid.Column="3"
                               MinWidth="72"
                               Command="{Binding DataContext.RunItemCommand, ElementName=page}"
                               CommandParameter="{Binding}"
                               Content="测试"
                               Icon="{ui:SymbolIcon Play16}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="AutomationContentRoot" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部控制栏 -->
            <Border Grid.Row="0"
                    Padding="14,12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button MinWidth="120"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.RunAllCommand}"
                                   Content="一键全流程"
                                   Icon="{ui:SymbolIcon Play20}"/>
                        <ui:Button Margin="8,0,0,0"
                                   Command="{Binding ViewModel.StopCommand}"
                                   Content="停止"
                                   Icon="{ui:SymbolIcon Stop16}"/>
                        <ui:Button Margin="8,0,0,0"
                                   Command="{Binding ViewModel.ResetCommand}"
                                   Content="重置"
                                   Icon="{ui:SymbolIcon ArrowReset20}"/>
                    </StackPanel>

                    <!-- 进度环（全流程进行中显示） -->
                    <ui:ProgressRing Grid.Column="2"
                                     Width="22"
                                     Height="22"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="{Binding ViewModel.IsRunningAll, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- 状态概览 -->
            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="14,10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding ViewModel.StatusText}"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Foreground="#4CAF50"
                                   Text="{Binding ViewModel.PassCount, StringFormat=合格 {0}}"/>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Foreground="#F44336"
                                   Text="{Binding ViewModel.FailCount, StringFormat=不合格 {0}}"/>
                        <TextBlock Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF9800"
                                   Text="{Binding ViewModel.TimeoutCount, StringFormat=超时 {0}}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding ViewModel.UnavailableCount, StringFormat=不可用 {0}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 测试项列表（按分组） -->
            <ScrollViewer Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 板级测试 -->
                    <TextBlock Margin="2,4,0,4"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="板级测试"/>
                    <ItemsControl ItemTemplate="{StaticResource TestItemTemplate}"
                                  ItemsSource="{Binding ViewModel.BoardTests}"/>

                    <!-- 外设测试 -->
                    <TextBlock Margin="2,14,0,4"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="外设测试"/>
                    <ItemsControl ItemTemplate="{StaticResource TestItemTemplate}"
                                  ItemsSource="{Binding ViewModel.PeripheralTests}"/>

                    <!-- 功能测试 -->
                    <TextBlock Margin="2,14,0,4"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="功能测试"/>
                    <ItemsControl ItemTemplate="{StaticResource TestItemTemplate}"
                                  ItemsSource="{Binding ViewModel.FunctionTests}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 未解锁厂家权限时的遮罩，阻止查看和交互 -->
        <Border x:Name="FactoryLockOverlay"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="1"
                Visibility="Collapsed"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LockClosed24"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="此页内容需要厂家权限"/>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="请先到“设置”页输入正确的厂家密码解锁"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
