<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.AppDataPages.AppLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.AppDataPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AppLogPage"
    d:DataContext="{d:DesignInstance local:AppLogPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ScrollViewer.CanContentScroll="False"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 级别指示器颜色 -->
            <Style x:Key="LevelDot" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="#9E9E9E" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Debug}">
                        <Setter Property="Fill" Value="#9E9E9E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Info}">
                        <Setter Property="Fill" Value="#2196F3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Warning}">
                        <Setter Property="Fill" Value="#FF9800" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Error}">
                        <Setter Property="Fill" Value="#F44336" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Critical}">
                        <Setter Property="Fill" Value="#B71C1C" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 鼠标悬停弹出: 完整内容 + 复制按钮 (供"消息"和"详情"两列复用) -->
            <Style x:Key="HoverPopupBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="MaxWidth" Value="640" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14"
                                          Direction="270"
                                          Opacity="0.25"
                                          ShadowDepth="3" />
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="18,8,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== Row 0: 标题 ========== -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="20"
            FontWeight="SemiBold"
            Text="应用日志" />

        <!-- ========== Row 1: 日志配置 ========== -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行: 基本配置 -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <CheckBox
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Content="启用日志"
                        IsChecked="{Binding ViewModel.IsLoggingEnabled, Mode=TwoWay}" />

                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="最低级别:" />
                    <ComboBox
                        Width="90"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding ViewModel.MinLevelOptions}"
                        SelectedItem="{Binding ViewModel.SelectedMinLevel, Mode=TwoWay}" />

                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="存储目录:" />
                    <TextBlock
                        MaxWidth="320"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.LogDirectory}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ViewModel.LogDirectory}" />

                    <ui:Button
                        Margin="0,0,4,0"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        Command="{Binding ViewModel.BrowseDirectoryCommand}"
                        Content="选择目录"
                        Icon="{ui:SymbolIcon Folder24}"
                        ToolTip="浏览并选择日志存储目录" />
                    <ui:Button
                        Padding="6,4"
                        VerticalAlignment="Center"
                        Command="{Binding ViewModel.OpenLogDirectoryCommand}"
                        Content="打开目录"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        ToolTip="在文件管理器中打开当前日志目录" />
                </WrapPanel>

                <!-- 第二行: 高级配置 -->
                <WrapPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="单文件上限:" />
                    <TextBox
                        Width="50"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="{Binding ViewModel.MaxFileSizeMB, Mode=TwoWay}"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="MB" />

                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="保留天数:" />
                    <TextBox
                        Width="50"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="{Binding ViewModel.RetentionDays, Mode=TwoWay}"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="天" />

                    <ui:Button
                        Padding="6,4"
                        VerticalAlignment="Center"
                        Command="{Binding ViewModel.CleanOldFilesCommand}"
                        Content="清理过期文件"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="删除超过保留天数的旧日志文件" />
                </WrapPanel>
            </Grid>
        </ui:Card>

        <!-- ========== Row 2: 筛选与操作栏 ========== -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,6"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <!-- 筛选 -->
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="级别:" />
                <ComboBox
                    Width="85"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding ViewModel.LevelFilterOptions}"
                    SelectedItem="{Binding ViewModel.SelectedLevelFilter, Mode=TwoWay}" />

                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="分类:" />
                <ComboBox
                    Width="100"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding ViewModel.CategoryFilterOptions}"
                    SelectedItem="{Binding ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                <ui:TextBox
                    Width="160"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索消息..."
                    Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 分隔 -->
                <Border
                    Width="1"
                    Height="22"
                    Margin="0,0,12,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- 操作按钮 -->
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    Command="{Binding ViewModel.RefreshLogsCommand}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    ToolTip="刷新" />
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    Command="{Binding ViewModel.LoadLogFileCommand}"
                    Content="加载文件"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    Command="{Binding ViewModel.LoadCurrentSessionCommand}"
                    Content="当前会话"
                    Icon="{ui:SymbolIcon Clock24}" />
                <ui:Button
                    Margin="0,0,4,0"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    Command="{Binding ViewModel.ExportLogsCommand}"
                    Content="导出"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Margin="0,0,12,0"
                    Padding="6,4"
                    VerticalAlignment="Center"
                    Command="{Binding ViewModel.ClearCurrentLogsCommand}"
                    Content="清空"
                    Icon="{ui:SymbolIcon Dismiss24}" />

                <CheckBox
                    VerticalAlignment="Center"
                    Content="自动滚动"
                    IsChecked="{Binding ViewModel.IsAutoScroll, Mode=TwoWay}" />
            </WrapPanel>
        </Border>

        <!-- ========== Row 3: 日志 DataGrid ========== -->
        <DataGrid
            Grid.Row="3"
            Margin="0,0,0,6"
            AutoGenerateColumns="False"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            FontSize="14"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            IsReadOnly="True"
            ItemsSource="{Binding ViewModel.FilteredEntries}"
            RowBackground="{DynamicResource ApplicationBackgroundBrush}"
            AlternatingRowBackground="{DynamicResource ControlFillColorDefaultBrush}"
            RowHeight="33"
            SelectionMode="Extended"
            VerticalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.ColumnHeaderStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,0" />
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Warning}">
                            <Setter Property="Background" Value="#18FF9800" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Error}">
                            <Setter Property="Background" Value="#18F44336" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:AppLogLevel.Critical}">
                            <Setter Property="Background" Value="#30B71C1C" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 序号 -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Index}"
                    Header="#">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 间隔 -->
                <DataGridTemplateColumn Width="12" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate />
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 时间 -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding TimestampText}"
                    Header="时间">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 间隔 -->
                <DataGridTemplateColumn Width="12" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate />
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 级别 (带彩色圆点) -->
                <DataGridTemplateColumn Width="SizeToCells" Header="级别">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Margin="0,0,5,0" Style="{StaticResource LevelDot}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="{Binding LevelText}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 间隔 -->
                <DataGridTemplateColumn Width="12" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate />
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 分类 -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding CategoryText}"
                    Header="分类">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 间隔 -->
                <DataGridTemplateColumn Width="12" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate />
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 消息 (悬停查看完整 + 复制) -->
                <DataGridTemplateColumn Width="SizeToCells" MaxWidth="600" Header="消息">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent"
                                  HorizontalAlignment="Left"
                                  MouseEnter="HoverCell_MouseEnter"
                                  MouseLeave="HoverCell_MouseLeave"
                                  Tag="{Binding Message}">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="14"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Popup x:Name="HoverPopup"
                                       AllowsTransparency="True"
                                       HorizontalOffset="-4"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                       PopupAnimation="Fade"
                                       StaysOpen="True"
                                       VerticalOffset="2">
                                    <Border MouseEnter="HoverPopupContent_MouseEnter"
                                            MouseLeave="HoverPopupContent_MouseLeave"
                                            Style="{StaticResource HoverPopupBorderStyle}">
                                        <DockPanel LastChildFill="True">
                                            <DockPanel DockPanel.Dock="Top"
                                                       Margin="0,0,0,6"
                                                       LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="消息" />
                                                <ui:Button DockPanel.Dock="Right"
                                                           Padding="6,2"
                                                           VerticalAlignment="Center"
                                                           Click="CopyHoverContent_Click"
                                                           CommandParameter="{Binding Message}"
                                                           Content="复制"
                                                           FontSize="11"
                                                           Icon="{ui:SymbolIcon Copy24}"
                                                           Tag="{Binding Message}"
                                                           ToolTip="复制到剪贴板" />
                                            </DockPanel>
                                            <TextBox Background="{DynamicResource ApplicationBackgroundBrush}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     MaxHeight="280"
                                                     Text="{Binding Message, Mode=OneWay}"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 间隔 -->
                <DataGridTemplateColumn Width="12" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate />
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 详情 (悬停查看完整 + 复制) -->
                <DataGridTemplateColumn Width="*" MinWidth="120" Header="详情">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent"
                                  HorizontalAlignment="Left"
                                  MouseEnter="HoverCell_MouseEnter"
                                  MouseLeave="HoverCell_MouseLeave"
                                  Tag="{Binding Details}">
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           Text="{Binding Details}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <Popup x:Name="HoverPopup"
                                       AllowsTransparency="True"
                                       HorizontalOffset="-4"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                       PopupAnimation="Fade"
                                       StaysOpen="True"
                                       VerticalOffset="2">
                                    <Border MouseEnter="HoverPopupContent_MouseEnter"
                                            MouseLeave="HoverPopupContent_MouseLeave"
                                            Style="{StaticResource HoverPopupBorderStyle}">
                                        <DockPanel LastChildFill="True">
                                            <DockPanel DockPanel.Dock="Top"
                                                       Margin="0,0,0,6"
                                                       LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="详情" />
                                                <ui:Button DockPanel.Dock="Right"
                                                           Padding="6,2"
                                                           VerticalAlignment="Center"
                                                           Click="CopyHoverContent_Click"
                                                           CommandParameter="{Binding Details}"
                                                           Content="复制"
                                                           FontSize="11"
                                                           Icon="{ui:SymbolIcon Copy24}"
                                                           Tag="{Binding Details}"
                                                           ToolTip="复制到剪贴板" />
                                            </DockPanel>
                                            <TextBox Background="{DynamicResource ApplicationBackgroundBrush}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     MaxHeight="280"
                                                     Text="{Binding Details, Mode=OneWay}"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ========== Row 4: 历史文件列表 (可折叠) ========== -->
        <Expander
            Grid.Row="4"
            Margin="0,0,0,6"
            Header="历史日志文件">
            <DataGrid
                MaxHeight="180"
                AutoGenerateColumns="False"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                IsReadOnly="True"
                ItemsSource="{Binding ViewModel.LogFiles}"
                RowBackground="{DynamicResource ApplicationBackgroundBrush}"
                AlternatingRowBackground="{DynamicResource ControlFillColorDefaultBrush}"
                SelectionMode="Single"
                VerticalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                VirtualizingPanel.IsVirtualizing="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="220"
                        Binding="{Binding FileName}"
                        Header="文件名">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding FileSizeText}"
                        Header="大小" />

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding LastModifiedText}"
                        Header="修改时间" />

                    <DataGridTemplateColumn Width="80" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.ViewModel.LoadHistoryFileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Content="加载"
                                    FontSize="11" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- ========== Row 5: 状态栏 ========== -->
        <Border
            Grid.Row="5"
            Padding="12,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="4">
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.CurrentFileName}" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding ViewModel.StatusText}" />

                    <Border
                        Width="1"
                        Height="14"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding ViewModel.TotalEntries, StringFormat=共 {0} 条}" />

                    <Border
                        Width="1"
                        Height="14"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <!-- 按级别统计（小药丸） -->
                    <Border
                        Margin="0,0,6,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#229E9E9E"
                        CornerRadius="9"
                        ToolTip="Debug">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.DebugCount, StringFormat=D {0}}" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#222196F3"
                        CornerRadius="9"
                        ToolTip="Info">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.InfoCount, StringFormat=I {0}}" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#33FF9800"
                        CornerRadius="9"
                        ToolTip="Warning">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.WarningCount, StringFormat=W {0}}" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#33F44336"
                        CornerRadius="9"
                        ToolTip="Error">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.ErrorCount, StringFormat=E {0}}" />
                    </Border>
                    <Border
                        Margin="0,0,12,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#44B71C1C"
                        CornerRadius="9"
                        ToolTip="Critical">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.CriticalCount, StringFormat=C {0}}" />
                    </Border>

                    <Border
                        Width="1"
                        Height="14"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding ViewModel.LoadedSource, StringFormat=来源: {0}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
