<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.FirmwarePages.FirmwareProgramPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FirmwarePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="固件烧录"
    d:DataContext="{d:DesignInstance local:FirmwareProgramPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ 设备连接状态 ══════ -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="14"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,8,0"
                         Fill="{DynamicResource TextFillColorDisabledBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#FF00CC66"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ViewModel.ConnectionInfo}"
                           FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="设备状态: " Opacity="0.6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ViewModel.DeviceState, FallbackValue='-'}"
                               FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════ 三个子菜单页 (TabControl) ══════ -->
        <TabControl Grid.Row="1" FontSize="15">

            <!-- ═══ 第一页: FoE 固件烧录 ═══ -->
            <TabItem Header="FoE 固件烧录" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,16">

                        <!-- ── 文件选择区 ── -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="选择固件文件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="浏览..." Margin="8,0,0,0"
                                               Width="100" Icon="{ui:SymbolIcon FolderOpen24}"
                                               Command="{Binding ViewModel.SelectFileCommand}"/>
                                    <ui:Button DockPanel.Dock="Right" Content="清除" Margin="8,0,0,0"
                                               Width="80" Icon="{ui:SymbolIcon Dismiss24}"
                                               Command="{Binding ViewModel.ClearFileCommand}"
                                               IsEnabled="{Binding ViewModel.IsFileSelected}"/>
                                    <Border Padding="10,8" CornerRadius="4" MinHeight="36"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Consolas" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未选择文件"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewModel.IsFileSelected}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ViewModel.SelectedFilePath}"/>
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- 文件信息 -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding ViewModel.IsFileSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="文件名: " Opacity="0.6"/>
                                    <TextBlock Text="{Binding ViewModel.SelectedFileName}" FontWeight="Medium" Margin="0,0,20,0"/>
                                    <TextBlock Text="大小: " Opacity="0.6"/>
                                    <TextBlock FontWeight="Medium">
                                        <TextBlock.Text>
                                            <Binding Path="ViewModel.SelectedFileSize" StringFormat="{}{0:N0} 字节"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- ── FoE 参数 ── -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="FoE 参数" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- FoE 目标文件名 -->
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="目标文件名" FontSize="15"
                                               FontWeight="Medium" VerticalAlignment="Center" Width="90"/>
                                    <TextBlock DockPanel.Dock="Right" Opacity="0.5" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="留空则使用本地文件名"/>
                                    <ui:TextBox Width="260" HorizontalAlignment="Left"
                                                PlaceholderText="例如 firmware.bin"
                                                Text="{Binding ViewModel.FoeTargetFileName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>

                                <!-- FoE 密码 -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="FoE 密码" FontSize="15"
                                               FontWeight="Medium" VerticalAlignment="Center" Width="90"/>
                                    <TextBlock DockPanel.Dock="Right" Opacity="0.5" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="十六进制 (如 0x1234) 或十进制"/>
                                    <ui:TextBox Width="260" HorizontalAlignment="Left"
                                                PlaceholderText="0"
                                                Text="{Binding ViewModel.FoePasswordText, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>

                                <!-- 已签名固件 (跳过 OTA 打包) -->
                                <CheckBox Margin="0,12,0,0"
                                          IsChecked="{Binding ViewModel.IsPreProcessedFirmware}"
                                          Content="已签名固件 (跳过 OTA 打包)"
                                          ToolTip="勾选此项表示所选文件已通过 pack_ota.py 处理，将直接烧录不再执行 OTA 签名打包"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- ── 烧录操作区 ── -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="烧录操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <ui:Button Content="开始烧录" Width="160" Margin="0,0,8,0"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowUpload24}"
                                               Command="{Binding ViewModel.BurnXmlCommand}"
                                               IsEnabled="{Binding ViewModel.IsFileSelected}"/>
                                </WrapPanel>

                                <!-- 进度条 -->
                                <StackPanel Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Height="8" Margin="0,0,0,8"
                                                 Minimum="0"
                                                 Maximum="{Binding ViewModel.ProgressMax}"
                                                 Value="{Binding ViewModel.ProgressValue}"/>
                                    <TextBlock HorizontalAlignment="Right" Opacity="0.6" FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} / {1:N0} 字节">
                                                <Binding Path="ViewModel.ProgressValue"/>
                                                <Binding Path="ViewModel.ProgressMax"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 状态文本 -->
                                <TextBlock Text="{Binding ViewModel.StatusText}" FontSize="14"
                                           Margin="0,8,0,0" Opacity="0.8"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- ── 烧录日志区 ── -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="烧录日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding ViewModel.BurnLog, Mode=OneWay}"
                                         FontFamily="Consolas" FontSize="13"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="200" MaxHeight="350"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         Background="{DynamicResource ApplicationBackgroundBrush}"
                                         Padding="8"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 第二页: EtherCAT 从站XML烧录 ═══ -->
            <TabItem Header="EtherCAT 从站XML烧录" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,16">

                        <!-- ── ESI XML 文件选择区 ── -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="选择 ESI XML 文件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="将 EtherCAT 从站信息 (ESI) XML 文件写入从站 EEPROM (SII)，类似 TwinCAT 的 &quot;Write EEPROM&quot; 功能。"
                                           FontSize="13" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="浏览..." Margin="8,0,0,0"
                                               Width="100" Icon="{ui:SymbolIcon FolderOpen24}"
                                               Command="{Binding ViewModel.SelectEsiFileCommand}"/>
                                    <ui:Button DockPanel.Dock="Right" Content="清除" Margin="8,0,0,0"
                                               Width="80" Icon="{ui:SymbolIcon Dismiss24}"
                                               Command="{Binding ViewModel.ClearEsiFileCommand}"
                                               IsEnabled="{Binding ViewModel.IsEsiFileSelected}"/>
                                    <Border Padding="10,8" CornerRadius="4" MinHeight="36"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="Consolas" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未选择文件"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewModel.IsEsiFileSelected}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ViewModel.EsiFilePath}"/>
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- ESI 文件信息 -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding ViewModel.IsEsiFileSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="文件名: " Opacity="0.6"/>
                                    <TextBlock Text="{Binding ViewModel.EsiFileName}" FontWeight="Medium" Margin="0,0,20,0"/>
                                    <TextBlock Text="大小: " Opacity="0.6"/>
                                    <TextBlock FontWeight="Medium">
                                        <TextBlock.Text>
                                            <Binding Path="ViewModel.EsiFileSize" StringFormat="{}{0:N0} 字节"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- ── EEPROM 烧录操作区 ── -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="EEPROM 烧录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <ui:Button Content="写入 EEPROM" Width="160" Margin="0,0,8,0"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowUpload24}"
                                               Command="{Binding ViewModel.BurnEsiCommand}"
                                               IsEnabled="{Binding ViewModel.IsEsiFileSelected}"/>
                                </WrapPanel>

                                <!-- 进度条 -->
                                <StackPanel Visibility="{Binding ViewModel.IsEsiBusy, Converter={StaticResource BoolToVisibility}}">
                                    <ProgressBar Height="8" Margin="0,0,0,8"
                                                 Minimum="0"
                                                 Maximum="{Binding ViewModel.EsiProgressMax}"
                                                 Value="{Binding ViewModel.EsiProgressValue}"/>
                                    <TextBlock HorizontalAlignment="Right" Opacity="0.6" FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} / {1:N0} words">
                                                <Binding Path="ViewModel.EsiProgressValue"/>
                                                <Binding Path="ViewModel.EsiProgressMax"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 状态文本 -->
                                <TextBlock Text="{Binding ViewModel.EsiStatusText}" FontSize="14"
                                           Margin="0,8,0,0" Opacity="0.8"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- ── ESI 烧录日志区 ── -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="烧录日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding ViewModel.EsiBurnLog, Mode=OneWay}"
                                         FontFamily="Consolas" FontSize="13"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="200" MaxHeight="350"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         Background="{DynamicResource ApplicationBackgroundBrush}"
                                         Padding="8"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 第三页: 控制器程序一级BOOT (占位) ═══ -->
            <TabItem Header="控制器程序一级BOOT" Padding="16,8">
                <Grid Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="48" Margin="0,0,0,16"/>
                        <TextBlock Text="控制器程序一级BOOT" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="此功能正在开发中，敬请期待..." FontSize="14"
                                   HorizontalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ═══ 第四页: 控制器程序二级BOOT (占位) ═══ -->
            <TabItem Header="控制器程序二级BOOT" Padding="16,8">
                <Grid Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="48" Margin="0,0,0,16"/>
                        <TextBlock Text="控制器程序二级BOOT" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="此功能正在开发中，敬请期待..." FontSize="14"
                                   HorizontalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
