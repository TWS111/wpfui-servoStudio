<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.AppDataPages.UserConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.AppDataPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="UserConfigPage"
    d:DataContext="{d:DesignInstance local:UserConfigPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Page.Resources>

    <Grid Margin="18,8,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="配置 JSON 读取 / 导出" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="软件中所有用户可自定义配置统一管理，任何更改都会自动写入本地 JSON 文件" />
        </StackPanel>

        <!-- Row 1: 文件路径 + 操作按钮 -->
        <ui:Card Grid.Row="1" Margin="0,0,0,8" Padding="14">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="本地配置文件:" />
                <TextBox
                    Width="520"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.SettingsPath, Mode=OneWay}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding ViewModel.OpenInExplorerCommand}"
                    Content="打开位置"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Command="{Binding ViewModel.ReloadCommand}"
                    Content="重新加载"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding ViewModel.ImportCommand}"
                    Content="从 JSON 导入"
                    Icon="{ui:SymbolIcon ArrowUpload24}" />
                <ui:Button
                    Margin="0,0,6,0"
                    Appearance="Primary"
                    Command="{Binding ViewModel.ExportCommand}"
                    Content="导出到 JSON"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button
                    Margin="0,0,0,0"
                    Appearance="Caution"
                    Command="{Binding ViewModel.ResetToDefaultCommand}"
                    Content="恢复默认"
                    Icon="{ui:SymbolIcon ArrowReset24}" />
            </WrapPanel>
        </ui:Card>

        <!-- Row 2: 可滚动的配置项区域 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>

                <!-- 左列：分组配置 -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                    <!-- 外观 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="外观 / 主题" />
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="主题模式:" />
                                <ComboBox
                                    Width="160"
                                    ItemsSource="{Binding ViewModel.ThemeOptions}"
                                    SelectedItem="{Binding ViewModel.ThemeMode, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 设备连接 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="设备连接 (添加设备页)" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="串口名:" />
                                <TextBox Width="120" Margin="0,0,16,0" Text="{Binding ViewModel.SerialPortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="波特率索引:" />
                                <ui:NumberBox Width="100" Margin="0,0,16,0" Minimum="-1" Maximum="64" Value="{Binding ViewModel.BaudIndex, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="数据位索引:" />
                                <ui:NumberBox Width="80" Margin="0,0,16,0" Minimum="-1" Maximum="16" Value="{Binding ViewModel.DataBitIndex, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="校验位索引:" />
                                <ui:NumberBox Width="80" Margin="0,0,16,0" Minimum="-1" Maximum="16" Value="{Binding ViewModel.CheckBitIndex, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="停止位索引:" />
                                <ui:NumberBox Width="80" Minimum="-1" Maximum="16" Value="{Binding ViewModel.StopBitIndex, Mode=TwoWay}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="以太网设备:" />
                                <TextBox Width="480" Text="{Binding ViewModel.EthernetDeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Modbus 从机地址:" />
                                <ui:NumberBox Width="100" Margin="0,0,16,0" Minimum="1" Maximum="247" Value="{Binding ViewModel.ModbusSlaveAddress, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CANopen 节点 ID:" />
                                <ui:NumberBox Width="100" Margin="0,0,16,0" Minimum="1" Maximum="127" Value="{Binding ViewModel.CanopenNodeId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CANopen 比特率索引:" />
                                <ui:NumberBox Width="100" Minimum="0" Maximum="8" Value="{Binding ViewModel.CanopenBitrateIndex, Mode=TwoWay}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="默认协议栈标签页 (0=EtherCAT, 1=CANopen, 2=Modbus):" />
                                <ui:NumberBox Width="80" Margin="0,0,16,0" Minimum="0" Maximum="2" Value="{Binding ViewModel.DeviceAddTabIndex, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CAN 适配器类别:" />
                                <TextBox Width="140" Margin="0,0,16,0" Text="{Binding ViewModel.CanAdapterKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="CanAdapterKind 枚举名称，如 PcanBasic / ControlCan / Slcan / Virtual 等" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CAN 适配器标识符:" />
                                <TextBox Width="240" Text="{Binding ViewModel.CanAdapterIdentifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="设备路径或序列号，与添加设备页自动枚举一致" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 运动 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="运动 / 周期同步" />
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="周期发送间隔 (ms):" />
                                <ui:NumberBox Width="140" Minimum="1" Maximum="10000" Value="{Binding ViewModel.CyclicSendIntervalMs, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 数据存储 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="数据存储 (DataSavePage)" />
                            <WrapPanel Margin="0,0,0,8">
                                <ui:ToggleSwitch
                                    Margin="0,0,20,0"
                                    Content="启动时自动开启本地存储"
                                    IsChecked="{Binding ViewModel.DataSaveAutoStart, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="采样间隔 (ms):" />
                                <ui:NumberBox Width="120" Margin="0,0,16,0" Minimum="10" Maximum="60000" Value="{Binding ViewModel.DataSavePollIntervalMs, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大样本数:" />
                                <ui:NumberBox Width="140" Margin="0,0,16,0" Minimum="100" Maximum="10000000" Value="{Binding ViewModel.DataSaveMaxSampleCount, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="单文件上限 (MB):" />
                                <ui:NumberBox Width="120" Margin="0,0,16,0" Minimum="1" Maximum="1024" Value="{Binding ViewModel.DataSaveMaxFileSizeMB, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="格式:" />
                                <ComboBox Width="100" ItemsSource="{Binding ViewModel.DataSaveFormatOptions}" SelectedItem="{Binding ViewModel.DataSaveFormat, Mode=TwoWay}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="本地目录:" />
                                <TextBox Width="520" Text="{Binding ViewModel.DataSaveDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </WrapPanel>

                            <!-- 变量选择（按组分） -->
                            <TextBlock Margin="0,10,0,4" FontSize="13" FontWeight="SemiBold" Text="参与采样的变量（按组）" />
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="勾选即自动持久化到 DataSave_SelectedVariables。" />
                            <Border
                                MaxHeight="260"
                                Padding="6"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ViewModel.DataVariablesView}">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,6,0,4"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                            Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding SourceText}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Margin="10,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding AddressText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ui:Card>

                    <!-- 固件（厂家专属） -->
                    <ui:Card Margin="0,0,0,8" Padding="14"
                             Visibility="{Binding ViewModel.IsFactoryUnlocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="固件 FoE 烧写" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           Foreground="#FF6A1B9A" Text="（厂家专属，导出时已加密）" />
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="目标文件名:" />
                                <TextBox Width="260" Margin="0,0,16,0" Text="{Binding ViewModel.FoeTargetFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="密码:" />
                                <TextBox Width="160" Margin="0,0,16,0" Text="{Binding ViewModel.FoePasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:ToggleSwitch
                                    Content="签名/预处理固件"
                                    IsChecked="{Binding ViewModel.IsPreProcessedFirmware, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 应用日志 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="应用日志 (AppLogPage)" />
                            <WrapPanel Margin="0,0,0,8">
                                <ui:ToggleSwitch
                                    Margin="0,0,20,0"
                                    Content="启用日志写入"
                                    IsChecked="{Binding ViewModel.AppLogEnabled, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Margin="0,0,20,0"
                                    Content="自动滚动"
                                    IsChecked="{Binding ViewModel.AppLogIsAutoScroll, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最低级别:" />
                                <ComboBox Width="120" Margin="0,0,16,0" ItemsSource="{Binding ViewModel.LogLevelOptions}" SelectedItem="{Binding ViewModel.AppLogMinLevel, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="单文件上限 (MB):" />
                                <ui:NumberBox Width="110" Margin="0,0,16,0" Minimum="1" Maximum="1024" Value="{Binding ViewModel.AppLogMaxFileSizeMB, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="保留天数:" />
                                <ui:NumberBox Width="100" Minimum="1" Maximum="3650" Value="{Binding ViewModel.AppLogRetentionDays, Mode=TwoWay}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="日志目录:" />
                                <TextBox Width="520" Text="{Binding ViewModel.AppLogDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 总线诊断 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="总线诊断 (BusDiagnosticsPage)" />
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="采样间隔 (ms):" />
                                <ui:NumberBox Width="120" Margin="0,0,20,0" Minimum="1" Maximum="60000" Value="{Binding ViewModel.BusDiagnosticsIntervalMs, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Content="探测 SDO 0x6041 (仅 EtherCAT)"
                                    IsChecked="{Binding ViewModel.BusDiagnosticsProbeSdo, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 波形窗 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="波形窗 (DataViewPage)" />
                            <WrapPanel>
                                <ui:ToggleSwitch
                                    Margin="0,0,20,0"
                                    Content="使用深色主题"
                                    IsChecked="{Binding ViewModel.DataViewIsDarkTheme, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="图例字号 (pt):" />
                                <ui:NumberBox Width="100" Minimum="8" Maximum="36" Value="{Binding ViewModel.DataViewLegendFontSize, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 调试 -->
                    <ui:Card Margin="0,0,0,8" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="调试 / 开发" />
                            <WrapPanel Margin="0,0,0,8">
                                <ui:ToggleSwitch
                                    Content="启用 Debug 模式（显示测试数据生成等控件）"
                                    IsChecked="{Binding ViewModel.IsDebugMode, Mode=TwoWay}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="测试数据目录:" />
                                <TextBox Width="520" Text="{Binding ViewModel.DataSaveTestDataDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- 已禁用寄存器（与厂家页联动，厂家专属，锁定时隐藏） -->
                    <ui:Card Margin="0,0,0,8" Padding="14"
                             Visibility="{Binding ViewModel.IsFactoryUnlocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="已禁用寄存器（与厂家页联动）" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                                           Foreground="#FF6A1B9A" Text="（厂家专属，导出时已加密）" />
                            </StackPanel>
                            <TextBlock Margin="0,0,0,8" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="下列寄存器与厂家页「禁用记忆」实时同步。仅以读方式呈现，修改请回到厂家页。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Text="EtherCAT" />
                                    <Border MaxHeight="160" Padding="4"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ViewModel.DisabledRegistersEtherCAT}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Text="CANopen" />
                                    <Border MaxHeight="160" Padding="4"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ViewModel.DisabledRegistersCANopen}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Text="Modbus" />
                                    <Border MaxHeight="160" Padding="4"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ViewModel.DisabledRegistersModbus}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- 右列：JSON 预览 -->
                <ui:Card Grid.Column="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="当前 JSON 预览 (实时)" />
                        <TextBox
                            Grid.Row="1"
                            FontFamily="Consolas, Courier New"
                            FontSize="12"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding ViewModel.JsonPreview, Mode=OneWay}" />
                    </Grid>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- Row 3: 状态栏 -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,6" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.StatusText}" />
        </Border>
    </Grid>
</Page>
