    <Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.MotionPages.MotionTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MotionTypePage"
    d:DataContext="{d:DesignInstance local:MotionTypePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid x:Name="grid" 
          ShowGridLines="False"
          Width="{Binding ActualWidth, ElementName=page, Mode=OneWay}" 
          Height="{Binding ActualHeight, ElementName=page, Mode=OneWay}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style TargetType="TextBlock" x:Key="LabelStyle">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="UnitStyle">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,4,0"/>
                <Setter Property="MinWidth" Value="48"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style TargetType="DockPanel" x:Key="ParameterRowStyle">
                <Setter Property="LastChildFill" Value="True"/>
                <Setter Property="Margin" Value="40,0,30,10"/>
            </Style>
            <Style TargetType="ui:Card" x:Key="ParameterCardStyle">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 模式选择 -->
        <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="控制模式与基本配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="控制模式切换 (0x6060):" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="16" FontWeight="Medium"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ViewModel.ComboBoxMotionMode}" SelectedIndex="{Binding ViewModel.MotionModeIndex}" MinWidth="220" Margin="0,0,12,0" HorizontalAlignment="Left"/>
                    <ui:Button Grid.Column="2" Content="应用运行模式" Command="{Binding ViewModel.ApplyModeCommand}" Appearance="Primary" MinWidth="120" />
                </Grid>
                <TextBlock Text="{Binding ViewModel.SelectedModeDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 参数面板区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,10">
            <StackPanel>
                <!-- PP 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsProfilePositionVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="轮廓位置模式参数 (PP)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标位置 0x607A — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标位置 [0x607A]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpTargetPosition, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="counts" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpTargetPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" SmallChange="100" LargeChange="10000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓速度 0x6081 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓速度 [0x6081]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓加速度 0x6083 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓加速度 [0x6083]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileAcceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓减速度 0x6084 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓减速度 [0x6084]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <CheckBox Content="相对位置 (IsRelative)" IsChecked="{Binding ViewModel.PpIsRelative}" Margin="0,0,24,0"/>
                            <CheckBox Content="立即变更 (ChangeImmediately)" IsChecked="{Binding ViewModel.PpChangeImmediately}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- VL 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsVelocityVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="速度模式参数 (VL)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.VlTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.VlTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- PV 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsProfileVelocityVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="轮廓速度模式参数 (PV)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓加速度 0x6083 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓加速度 [0x6083]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvProfileAcceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvProfileAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓减速度 0x6084 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓减速度 [0x6084]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvProfileDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvProfileDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 急停减速度 0x6085 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="急停减速度 [0x6085]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvQuickStopDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvQuickStopDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- TQ 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsProfileTorqueVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="轮廓转矩模式参数 (TQ)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标转矩 0x6071 — INT16 (千分比 ‰) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标转矩 [0x6071]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.TqTargetTorque, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.TqTargetTorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 最大转矩 0x6072 — UINT16 (千分比 ‰) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="最大转矩 [0x6072]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.TqMaxTorque, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.TqMaxTorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩斜坡 0x6087 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩斜坡 [0x6087]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.TqTorqueSlope, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.TqTorqueSlope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="10000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- HM 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsHomingVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="原点回归配置 (HM)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="回零方法 [0x6098]:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ViewModel.HmMethodItems}" SelectedIndex="{Binding ViewModel.HmMethodIndex}" MinWidth="220" MaxWidth="420" HorizontalAlignment="Left"/>
                        </DockPanel>
                        <!-- 寻找开关速度 0x6099-1 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="寻找开关速度 [0x6099-1]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.HmSpeedDuringSearch, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.HmSpeedDuringSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 寻找零点速度 0x6099-2 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="寻找零点速度 [0x6099-2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.HmSpeedDuringZero, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.HmSpeedDuringZero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 回零加速度 0x609A — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="回零加速度 [0x609A]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.HmHomingAcceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.HmHomingAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- IP 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsInterpolatedPositionVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="插补位置模式参数 (IP)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.IpInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.IpInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- CSP 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsCspVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="周期同步位置参数 (CSP)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标位置 0x607A — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标位置 [0x607A]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CspTargetPosition, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="counts" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CspTargetPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" SmallChange="100" LargeChange="10000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 位置前馈 0x60B0 — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="位置前馈 [0x60B0]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CspPositionOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="counts" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CspPositionOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" SmallChange="100" LargeChange="10000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 速度前馈 0x60B1 — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="速度前馈 [0x60B1]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CspVelocityOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CspVelocityOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩前馈 0x60B2 — INT16 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩前馈 [0x60B2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CspTorqueOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CspTorqueOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CspInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CspInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- CSV 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsCsvVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="周期同步速度参数 (CSV)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 速度前馈 0x60B1 — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="速度前馈 [0x60B1]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvVelocityOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvVelocityOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩前馈 0x60B2 — INT16 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩前馈 [0x60B2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvTorqueOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvTorqueOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CsvInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CsvInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <!-- CST 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsCstVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="周期同步转矩参数 (CST)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标转矩 0x6071 — INT16 (千分比 ‰) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标转矩 [0x6071]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstTargetTorque, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstTargetTorque, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 转矩前馈 0x60B2 — INT16 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="转矩前馈 [0x60B2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstTorqueOffset, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="‰" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstTorqueOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-32768" Maximum="32767" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 插补周期 0x60C2 — UINT32 (µs) -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="插补周期 [0x60C2]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.CstInterpolationTimePeriod, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="µs" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.CstInterpolationTimePeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" SmallChange="100" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部应用按钮 -->
        <Border Grid.Row="2" Margin="0,0,0,0" Padding="15" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="下发参数配置" Command="{Binding ViewModel.ApplyParametersCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Width="150" Height="36"/>
                </StackPanel>
                <TextBlock Text="{Binding ViewModel.OperationStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

    </Grid>
</Page>
