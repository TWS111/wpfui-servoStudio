<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Wpf.Ui.servoStudio.Services"
    xmlns:pages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.DeviceSetPages"
    xmlns:hardwarePages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.HardwarePages"
    xmlns:motionPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
    xmlns:parametersPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.ParametersPages"
    xmlns:firmwarePages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FirmwarePages"
    xmlns:appDataPages="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.AppDataPages"
    Title="首页"
    ScrollViewer.CanContentScroll="False"
    d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=False}"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Key="CardMouseEnter">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.02" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.02" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CardMouseLeave">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DescFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DescFadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
        </Storyboard>

        <Style x:Key="QuickAccessCardStyle" TargetType="ui:CardAction">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="Card_MouseEnter" />
            <EventSetter Event="MouseLeave" Handler="Card_MouseLeave" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseEnter}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource CardMouseLeave}" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryCardStyle" TargetType="ui:CardAction" BasedOn="{StaticResource QuickAccessCardStyle}">
            <Setter Property="MinHeight" Value="80" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,12,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <Style x:Key="CardBodyStyle" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="ContentPresenter" x:Key="CenteredItemContainerStyle">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="420" />
            <ColumnDefinition Width="3*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：可滚动的功能区 -->
        <ScrollViewer
            Grid.Column="0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="False"
            PanningMode="VerticalOnly"
            Padding="20,12,10,12">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="GX Servo Studio" FontSize="28" FontWeight="Bold" Margin="4,4,0,2" />
                <TextBlock Text="伺服驱动器调试与配置工具" FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,12" />

                <TextBlock Text="快速入口" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}" Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <ItemsControl ItemsSource="{Binding ViewModel.QuickAccessItems}" ItemContainerStyle="{StaticResource CenteredItemContainerStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left"  Margin="0, -10, 0, -30"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:QuickAccessItem}">
                                <ui:CardAction
                                    Style="{StaticResource QuickAccessCardStyle}"
                                    Tag="{Binding}"
                                    Command="{Binding DataContext.ViewModel.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding PageType}">
                                    <Grid Style="{StaticResource CardBodyStyle}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:SymbolIcon Grid.Row="0" Symbol="{Binding Icon}" FontSize="30" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ===== 设备管理 ===== -->
                <TextBlock Text="设备管理" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type pages:StartPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="设备连接" Description="添加、选择、断开设备" Icon="PlugConnected24" PageType="{x:Type pages:StartPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="PlugConnected24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="设备连接" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type pages:ListPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="设备列表" Description="查看已连接设备" Icon="TextBulletList20" PageType="{x:Type pages:ListPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="TextBulletList20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="设备列表" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type pages:DeviceAddPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="添加设备" Description="扫描并添加新设备" Icon="AddCircle24" PageType="{x:Type pages:DeviceAddPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="AddCircle24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="添加设备" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 实时监控 ===== -->
                <TextBlock Text="实时监控" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type local:ControlPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="控制台" Description="实时控制与调试伺服驱动器" Icon="DesktopCursor24" PageType="{x:Type local:ControlPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="DesktopCursor24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="控制台" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type local:DashboardPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="仪表盘" Description="设备状态实时监控面板" Icon="Gauge24" PageType="{x:Type local:DashboardPage}" />
                            </ui:CardAction.Tag>
                            <Grid Margin="0,0,32,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Gauge24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="仪表盘" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 故障与诊断 ===== -->
                <TextBlock Text="故障与诊断" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type local:FaultInfoPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="故障信息" Description="查看故障告警记录与诊断信息" Icon="Warning24" PageType="{x:Type local:FaultInfoPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Warning24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="故障信息" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 硬件配置 ===== -->
                <TextBlock Text="硬件配置" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type local:HardwarePage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="硬件总览" Description="硬件配置状态概览" Icon="DeveloperBoard16" PageType="{x:Type local:HardwarePage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="DeveloperBoard16" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="硬件总览" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type hardwarePages:ControllerPage}" Width="148">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="控制器参数" Description="配置控制器硬件参数" Icon="DeveloperBoardLightning20" PageType="{x:Type hardwarePages:ControllerPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="DeveloperBoardLightning20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="控制器参数" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type hardwarePages:MotorPage}" Width="158">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="电机参数" Description="配置电机额定参数与编码器设置" Icon="ArrowSync20" PageType="{x:Type hardwarePages:MotorPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="ArrowSync20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="电机参数" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type hardwarePages:IOPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="IO配置" Description="输入输出端口逻辑配置" Icon="ArrowSwap20" PageType="{x:Type hardwarePages:IOPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="ArrowSwap20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="IO配置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 运动控制 ===== -->
                <TextBlock Text="运动控制" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type motionPages:MotionTypePage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="控制模式" Description="配置运动控制方式（位置/速度/力矩）" Icon="MapDrive16" PageType="{x:Type motionPages:MotionTypePage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="MapDrive16" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="控制模式" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type motionPages:MotionLimitPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="运动限制" Description="配置位置/速度/力矩限制参数" Icon="CenterHorizontal20" PageType="{x:Type motionPages:MotionLimitPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="CenterHorizontal20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="运动限制" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 参数管理 ===== -->
                <TextBlock Text="参数管理" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type appDataPages:PidAdjustPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="PID调节" Description="PID参数调整与阶跃响应曲线" Icon="StreamInputOutput20" PageType="{x:Type appDataPages:PidAdjustPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="StreamInputOutput20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="PID调节" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type parametersPages:FactoryPage}" Width="164">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="厂家参数" Description="查看与修改出厂默认参数" Icon="CalendarLock20" PageType="{x:Type parametersPages:FactoryPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="CalendarLock20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="厂家参数" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 数据与日志 ===== -->
                <TextBlock Text="数据与日志" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type appDataPages:DataSavePage}" Width="170">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="数据存储" Description="伺服变量采样与CSV导出" Icon="ArrowDownload24" PageType="{x:Type appDataPages:DataSavePage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="ArrowDownload24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="数据存储" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type appDataPages:DataViewPage}" Width="162">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="数据查看" Description="导入并查看历史数据记录" Icon="Table24" PageType="{x:Type appDataPages:DataViewPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Table24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="数据查看" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type appDataPages:UserConfigPage}" Width="158">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="用户配置" Description="保存与加载用户参数配置文件" Icon="Person20" PageType="{x:Type appDataPages:UserConfigPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Person20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="用户配置" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type appDataPages:AppLogPage}" Width="170">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="软件日志" Description="查看应用运行日志与事件记录" Icon="DocumentChevronDouble20" PageType="{x:Type appDataPages:AppLogPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="DocumentChevronDouble20" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="软件日志" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>

                <!-- ===== 固件管理 ===== -->
                <TextBlock Text="固件管理" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource GroupBorder}">
                    <WrapPanel HorizontalAlignment="Left" Margin="0, -10, 0, -30">
                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type firmwarePages:FirmwareProgramPage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="固件烧录" Description="EtherCAT XML烧录与BOOT引导" Icon="Flash24" PageType="{x:Type firmwarePages:FirmwareProgramPage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Flash24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="固件烧录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type firmwarePages:FirmwarePage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="EEPROM提取" Description="读取并导出设备EEPROM数据" Icon="Memory16" PageType="{x:Type firmwarePages:FirmwarePage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="Memory16" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="EEPROM提取" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>

                        <ui:CardAction Style="{StaticResource PrimaryCardStyle}"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type firmwarePages:FactoryFirmwarePage}" Width="166">
                            <ui:CardAction.Tag>
                                <services:QuickAccessItem Title="出厂固件" Description="管理与烧录出厂标准固件" Icon="HardDrive20" PageType="{x:Type firmwarePages:FactoryFirmwarePage}" />
                            </ui:CardAction.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Grid.Row="0" Symbol="HardDrive24" FontSize="26" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="出厂固件" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </ui:CardAction>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧：固定的功能描述面板（不随主区滚动） -->
        <Border x:Name="DescriptionPanel"
                Grid.Column="1"
                Style="{StaticResource GroupBorder}"
                Margin="10,20,20,20"
                Padding="14"
                Opacity="0"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="功能说明" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding HoverTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HoverDescription}" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
