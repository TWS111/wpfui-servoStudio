    <Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.MotionPages.MotionTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MotionTypePage"
    d:DataContext="{d:DesignInstance local:MotionTypePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid x:Name="grid" 
          ShowGridLines="False"
          Width="{Binding ActualWidth, ElementName=page, Mode=OneWay}" 
          Height="{Binding ActualHeight, ElementName=page, Mode=OneWay}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style TargetType="TextBlock" x:Key="LabelStyle">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="UnitStyle">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,4,0"/>
                <Setter Property="MinWidth" Value="48"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style TargetType="DockPanel" x:Key="ParameterRowStyle">
                <Setter Property="LastChildFill" Value="True"/>
                <Setter Property="Margin" Value="40,0,30,10"/>
            </Style>
            <Style TargetType="ui:Card" x:Key="ParameterCardStyle">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 控制模式配置 (0x6060 + H02) -->
        <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock Text="控制模式配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- 运行模式并排：CiA402 0x6060 | H02.00 驱动存储模式 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左：CiA402 0x6060 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CiA402 操作模式 (0x6060)" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding ViewModel.ComboBoxMotionMode}"
                                      SelectedIndex="{Binding ViewModel.MotionModeIndex}" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Content="应用" Command="{Binding ViewModel.ApplyModeCommand}"
                                       Appearance="Primary" MinWidth="80"/>
                        </Grid>
                    </StackPanel>
                    <!-- 右：H02.00 驱动存储模式 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="13" FontWeight="Medium" Margin="0,0,0,6">
                            <Run Text="驱动器控制模式 (H02.00)"/>
                            <Run Text="  ★ 写入后需执行参数存储" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </TextBlock>
                        <ComboBox SelectedIndex="{Binding ViewModel.CtrlMode}">
                            <ComboBoxItem Content="0 - 转矩控制"/>
                            <ComboBoxItem Content="1 - 速度控制"/>
                            <ComboBoxItem Content="2 - 位置控制"/>
                            <ComboBoxItem Content="3 - 多模式（默认）"/>
                            <ComboBoxItem Content="4 - 同步模式"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- H02.02 旋转方向 -->
                <CheckBox Margin="0,0,0,10" Content="H02.02  旋转方向反转 (CCW)"
                          IsChecked="{Binding ViewModel.ReverseDirection}"/>

                <!-- H02 停机方式（2 列 × 2 行） -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- H02.05 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                        <TextBlock Text="H02.05  OFF停机方式" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding ViewModel.OffStopMode}">
                            <ComboBoxItem Content="0 - 自由停机"/>
                            <ComboBoxItem Content="1 - 减速停机"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- H02.06 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="H02.06  故障停机方式" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding ViewModel.FaultStopMode}">
                            <ComboBoxItem Content="0 - 自由停机"/>
                            <ComboBoxItem Content="1 - 减速至零"/>
                            <ComboBoxItem Content="2 - 快速减速"/>
                            <ComboBoxItem Content="3 - 保持力矩"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- H02.07 -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="H02.07  急停停机方式" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding ViewModel.QuickStopMode}">
                            <ComboBoxItem Content="0 - 自由停机"/>
                            <ComboBoxItem Content="1 - 减速至零"/>
                            <ComboBoxItem Content="2 - 快速减速"/>
                            <ComboBoxItem Content="3 - 保持力矩"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- H02.08 -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="H02.08  主电源缺相方式" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding ViewModel.PowerLossMode}">
                            <ComboBoxItem Content="0 - 忽略"/>
                            <ComboBoxItem Content="1 - 报警停机"/>
                            <ComboBoxItem Content="2 - 故障停机"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- H02 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Margin="0,0,8,0" Content="读取 H02" Command="{Binding ViewModel.ReadH02Command}"/>
                    <ui:Button Margin="0,0,12,0" Appearance="Primary" Content="写入 H02" Command="{Binding ViewModel.WriteH02Command}"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ViewModel.H02Status}"/>
                </StackPanel>

                <!-- 当前 CiA402 模式说明 -->
                <TextBlock Text="{Binding ViewModel.SelectedModeDescription}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ui:Card>


        <!-- 参数面板区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,0,10">
            <StackPanel>
                <!-- PP 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsProfilePositionVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="轮廓位置模式参数 (PP)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标位置 0x607A — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标位置 [0x607A]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpTargetPosition, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="counts" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpTargetPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" SmallChange="100" LargeChange="10000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓速度 0x6081 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓速度 [0x6081]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓加速度 0x6083 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓加速度 [0x6083]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileAcceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓减速度 0x6084 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓减速度 [0x6084]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpProfileDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpProfileDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 急停减速度 0x6085 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="急停减速度 [0x6085]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PpQuickStopDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PpQuickStopDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Margin="0,8,0,12" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="厂商自定义 H05 位置控制参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.00 位置指令来源" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05PosCmdSource, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="2" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.02 电子齿轮分子1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05GearNum1, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.04 电子齿轮分母1" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05GearDen1, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.20 定位接近阈值" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05PositionNearThreshold, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.21 定位完成阈值" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05PositionThreshold, UpdateSourceTrigger=PropertyChanged}" Minimum="5" Maximum="255" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.30 位置低通滤波(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05PositionLpfTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H05.31 S曲线滤波(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PpH05PositionSCurveMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <CheckBox Content="相对位置 (IsRelative)" IsChecked="{Binding ViewModel.PpIsRelative}" Margin="0,0,24,0"/>
                            <CheckBox Content="立即变更 (ChangeImmediately)" IsChecked="{Binding ViewModel.PpChangeImmediately}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- VL 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsVelocityVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="速度模式参数 (VL)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.VlTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.VlTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="厂商自定义 H06 速度控制参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.00 速度指令来源" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06SpeedCmdSource, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="5" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.05 加速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06AccTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.06 减速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06DecTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.07 S曲线时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06SCurveTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.10 零速钳位使能" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06ZeroClampEn, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.11 零速钳位阈值(rpm)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.VlH06ZeroClampThreshold, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- PV 视图 -->
                <ui:Card Visibility="{Binding ViewModel.IsProfileVelocityVisible, Converter={StaticResource BoolToVis}}" Style="{StaticResource ParameterCardStyle}">
                    <StackPanel>
                        <TextBlock Text="轮廓速度模式参数 (PV)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <!-- 目标速度 0x60FF — INT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="目标速度 [0x60FF]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvTargetVelocity, UpdateSourceTrigger=PropertyChanged}" Minimum="-2147483648" Maximum="2147483647" MaxDecimalPlaces="0" SmallChange="1" LargeChange="100" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvTargetVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-10000" Maximum="10000" SmallChange="1" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓加速度 0x6083 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓加速度 [0x6083]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvProfileAcceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvProfileAcceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 轮廓减速度 0x6084 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="轮廓减速度 [0x6084]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvProfileDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvProfileDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- 急停减速度 0x6085 — UINT32 -->
                        <DockPanel Style="{StaticResource ParameterRowStyle}">
                            <TextBlock Text="急停减速度 [0x6085]:" Style="{StaticResource LabelStyle}"/>
                            <ui:NumberBox Value="{Binding ViewModel.PvQuickStopDeceleration, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="4294967295" MaxDecimalPlaces="0" SmallChange="1" LargeChange="1000" MinWidth="260" MaxWidth="420" Height="38" FontSize="17" HorizontalAlignment="Left"/>
                            <TextBlock Text="rpm/s" Style="{StaticResource UnitStyle}"/>
                            <Slider Value="{Binding ViewModel.PvQuickStopDeceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="500000" SmallChange="10" LargeChange="1000" IsSnapToTickEnabled="True" TickFrequency="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="厂商自定义 H06 速度控制参数" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.05 加速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PvH06AccTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.06 减速时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PvH06DecTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="65535" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.07 S曲线时间(ms)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PvH06SCurveTimeMs, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1000" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.10 零速钳位使能" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:NumberBox Value="{Binding ViewModel.PvH06ZeroClampEn, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" MaxDecimalPlaces="0" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,10">
                                        <TextBlock Text="H06.11 零速钳位阈值(rpm)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
