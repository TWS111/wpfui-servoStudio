                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="调试运行" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="状态机与 PID 调节" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="前往" Height="32" MinWidth="48" FontSize="12"
                                       VerticalAlignment="Center"
                                       Command="{Binding ViewModel.NavigateToCommand}"
                                       CommandParameter="{x:Type local:ControlPage}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="4,14,4,14"/>

                <!-- 最近访问 -->
                <TextBlock Text="最近访问" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ViewModel.QuickAccessItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type services:QuickAccessItem}">
                            <ui:CardAction Margin="0,3" Padding="10,9"
                                           Command="{Binding DataContext.ViewModel.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding PageType}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="22"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="4,14,4,14"/>

                <!-- 功能说明（悬停时更新） -->
                <TextBlock Text="功能说明" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="DescriptionSection"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12"
                        Opacity="0.45">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding HoverTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HoverTitle}" Value="">
                                            <Setter Property="Text" Value="悬停功能卡片查看说明"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding HoverDescription}" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>