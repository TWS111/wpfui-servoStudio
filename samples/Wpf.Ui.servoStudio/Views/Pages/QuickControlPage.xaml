<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.QuickControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="QuickControlPage"
    d:DataContext="{d:DesignInstance local:QuickControlPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TelemetryCellStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,20,32">
            <ui:Card Margin="0,0,0,0" Padding="16">
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="连接 / 当前模式" />
                    </Expander.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="当前连接" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding ViewModel.ConnectionInfo}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ViewModel.CurrentModeDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" MinWidth="220" Margin="24,0,0,0">
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="当前运行模式" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding ViewModel.CurrentModeName}" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16">
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="在线波形" />
                    </Expander.Header>
                    <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="380" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="在线波形" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ViewModel.TotalChannels, StringFormat=通道:{0}}" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Padding="10,8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6">
                        <WrapPanel VerticalAlignment="Center">
                            <ui:Button
                                Margin="0,0,4,0"
                                Padding="8,4"
                                Click="OnToggleTheme"
                                Content="深/浅"
                                Icon="{ui:SymbolIcon DarkTheme24}"
                                ToolTip="切换波形图深色 / 浅色背景" />
                            <ui:Button
                                MinWidth="0"
                                Margin="0,0,2,0"
                                Padding="6,4"
                                Click="OnLegendFontDec"
                                Content="A-"
                                ToolTip="减小图例字号" />
                            <ui:Button
                                MinWidth="0"
                                Margin="0,0,12,0"
                                Padding="6,4"
                                Click="OnLegendFontInc"
                                Content="A+"
                                ToolTip="增大图例字号" />

                            <Border Width="1" Height="20" Margin="0,0,12,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <ui:Button
                                Margin="0,0,8,0"
                                Padding="8,4"
                                Command="{Binding ViewModel.ShowAllChannelsCommand}"
                                Content="全部显示" />
                            <ui:Button
                                Margin="0,0,16,0"
                                Padding="8,4"
                                Command="{Binding ViewModel.HideAllChannelsCommand}"
                                Content="全部隐藏" />

                            <Border Width="1" Height="20" Margin="0,0,12,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Text="{Binding ViewModel.TotalChannels, StringFormat=通道:{0}}" />
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" Text="{Binding ViewModel.TotalSamples, StringFormat=样本:{0}}" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Text="显示容量" />
                            <ui:NumberBox
                                Width="100"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ClearButtonEnabled="False"
                                LargeChange="500"
                                MaxDecimalPlaces="0"
                                Maximum="100000"
                                Minimum="10"
                                SmallChange="100"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding ViewModel.LiveDisplayCapacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Text="超容" />
                            <ComboBox
                                Width="110"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                SelectedIndex="{Binding ViewModel.LiveOverflowModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="滚动" />
                                <ComboBoxItem Content="扫屏" />
                            </ComboBox>

                            <Border Width="1" Height="20" Margin="0,0,12,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <ui:Button
                                x:Name="LivePauseButton"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Appearance="Secondary"
                                Click="OnPauseLiveRefresh"
                                Content="暂停刷新"
                                Icon="{ui:SymbolIcon Pause24}"
                                ToolTip="暂停波形窗实时刷新（数据采样不受影响）" />
                            <ui:Button
                                x:Name="LiveResumeButton"
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Appearance="Secondary"
                                Click="OnResumeLiveRefresh"
                                Content="恢复刷新"
                                Icon="{ui:SymbolIcon Play24}"
                                ToolTip="恢复波形窗实时刷新"
                                Visibility="Collapsed" />
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="260" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>

                            <ComboBox
                                Grid.Row="0"
                                MinHeight="36"
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding ViewModel.FilteredCatalog}"
                                MaxDropDownHeight="360"
                                StaysOpenOnEdit="True"
                                Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="输入关键字后展开并勾选 CiA 或 H 组变量">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Padding="4,3"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <Grid Width="292">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="38"
                                                    Height="22"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding SourceLabel}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Group}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding AddressDisplay}" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Border
                                Grid.Row="1"
                                Margin="0,10,0,10"
                                Padding="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ViewModel.FilteredCatalog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Margin="0,0,0,6"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding AddressDisplay}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Padding="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="通道 (按钮切换)" />
                                        <ui:Button
                                            Grid.Column="1"
                                            MinWidth="64"
                                            Height="28"
                                            Padding="8,0"
                                            Command="{Binding ViewModel.ClearAllChannelsCommand}"
                                            Content="清空"
                                            Icon="{ui:SymbolIcon Delete20}" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ViewModel.ActiveChannels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            Grid.Column="0"
                                                            Padding="8,6"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{Binding ColorHex}"
                                                            BorderThickness="2"
                                                            Command="{Binding DataContext.ViewModel.ToggleChannelCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                            <Setter Property="Opacity" Value="1.0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <Border
                                                                        MinWidth="34"
                                                                        Padding="4,1"
                                                                        HorizontalAlignment="Center"
                                                                        Background="{Binding ColorHex}"
                                                                        CornerRadius="3">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            FontFamily="Consolas"
                                                                            FontSize="11"
                                                                            FontWeight="Bold"
                                                                            Foreground="Black"
                                                                            Text="{Binding ChannelLabel}" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        Margin="0,2,0,0"
                                                                        HorizontalAlignment="Center"
                                                                        FontFamily="Consolas"
                                                                        FontSize="10"
                                                                        FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="OFF" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                                        <Setter Property="Text" Value="ON" />
                                                                                        <Setter Property="Foreground" Value="{Binding ColorHex}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding DisplayLabel}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                        Text="{Binding Variable.AddressDisplay}" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Consolas"
                                                                    FontSize="10"
                                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                    Text="{Binding Count, StringFormat='N {0}'}" />
                                                            </Grid>
                                                        </Button>
                                                        <ui:Button
                                                            Grid.Column="1"
                                                            Width="28"
                                                            Height="28"
                                                            Margin="6,4,0,0"
                                                            Padding="0"
                                                            Command="{Binding DataContext.ViewModel.RemoveChannelByItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding Variable}"
                                                            Icon="{ui:SymbolIcon Dismiss20}"
                                                            ToolTip="移除此通道" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter
                            Grid.Column="1"
                            Width="10"
                            HorizontalAlignment="Stretch"
                            Background="Transparent" />

                        <Border
                            Grid.Column="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <scottplot:WpfPlot x:Name="Plot" />
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Padding="10,6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Text="X 范围:" />
                            <ui:NumberBox
                                x:Name="XMinBox"
                                Width="120"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                ClearButtonEnabled="False"
                                KeyDown="OnXRangeKeyDown"
                                LargeChange="100"
                                MaxDecimalPlaces="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                ToolTip="X 轴左端（仅整数；按回车应用）"
                                ValueChanged="OnXRangeValueChanged" />
                            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="—" />
                            <ui:NumberBox
                                x:Name="XMaxBox"
                                Width="120"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ClearButtonEnabled="False"
                                KeyDown="OnXRangeKeyDown"
                                LargeChange="100"
                                MaxDecimalPlaces="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                ToolTip="X 轴右端（仅整数；按回车应用）"
                                ValueChanged="OnXRangeValueChanged" />
                            <ui:Button Margin="0,0,12,0" Padding="8,4" Click="OnApplyXRange" Content="应用" />

                            <Border Width="1" Height="20" Margin="0,0,12,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="OnAutoX"
                                Content="自动 X"
                                Icon="{ui:SymbolIcon AutoFitWidth24}"
                                ToolTip="自动缩放横轴" />
                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Click="OnAutoY"
                                Content="自动 Y"
                                Icon="{ui:SymbolIcon AutoFitHeight24}"
                                ToolTip="自动缩放纵轴" />
                            <ui:Button
                                Margin="0,0,6,0"
                                Padding="8,4"
                                Appearance="Secondary"
                                Click="OnAutoAll"
                                Content="全自动"
                                Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                ToolTip="全自动缩放（X+Y）" />
                        </WrapPanel>
                    </Border>
                    </Grid>
                </Expander>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16">
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="伺服快捷操作 + 当前模式 CiA 参数快调" />
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前模式 CiA 参数快调" />
                        <WrapPanel Grid.Column="1">
                            <CheckBox
                                Margin="0,0,12,8"
                                VerticalAlignment="Center"
                                Content="自动读取（1s）"
                                IsChecked="{Binding ViewModel.IsAutoReadEnabled, Mode=TwoWay}"
                                ToolTip="启用后周期性从伺服读取参数值；编辑中的项会被跳过" />
                            <ui:Button
                                MinWidth="118"
                                Height="34"
                                Margin="0,0,8,8"
                                Command="{Binding ViewModel.ReadMotionParametersCommand}"
                                Content="读取参数"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button
                                MinWidth="118"
                                Height="34"
                                Margin="0,0,8,8"
                                Appearance="Primary"
                                Command="{Binding ViewModel.ApplyMotionParametersCommand}"
                                Content="下发参数"
                                Icon="{ui:SymbolIcon ArrowUpload24}" />
                            <ui:Button
                                MinWidth="118"
                                Height="34"
                                Margin="0,0,0,8"
                                Appearance="Secondary"
                                Command="{Binding ViewModel.ApplySelectedModeCommand}"
                                Content="应用模式"
                                Icon="{ui:SymbolIcon Checkmark24}" />
                        </WrapPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ViewModel.MotionParameters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="360"
                                    MinHeight="88"
                                    Margin="0,0,10,10"
                                    Padding="12,10"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding AddressDisplay}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TypeLabel}" />

                                        <ui:NumberBox
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Height="34"
                                            Margin="0,0,8,0"
                                            ClearButtonEnabled="False"
                                            GotFocus="OnParameterEditorGotFocus"
                                            LargeChange="{Binding LargeChange}"
                                            LostFocus="OnParameterEditorLostFocus"
                                            MaxDecimalPlaces="0"
                                            Maximum="{Binding Maximum}"
                                            Minimum="{Binding Minimum}"
                                            SmallChange="{Binding SmallChange}"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock
                                                MinWidth="44"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Unit}" />
                                            <ui:Button
                                                Width="34"
                                                Height="34"
                                                Padding="0"
                                                Command="{Binding DataContext.ViewModel.ApplyMotionParameterCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Send24}"
                                                ToolTip="下发此项" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.MotionParameterStatusText}" />

                    <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="伺服快捷操作" />
                    <WrapPanel>
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Primary"
                            Command="{Binding ViewModel.QuickEnableCommand}"
                            Content="伺服使能"
                            Icon="{ui:SymbolIcon Play24}" />
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.DisableOperationCommand}"
                            Content="失能运行"
                            Icon="{ui:SymbolIcon Stop24}" />
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Danger"
                            Command="{Binding ViewModel.QuickStopCommand}"
                            Content="急停"
                            Icon="{ui:SymbolIcon Warning24}" />
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.FaultResetCommand}"
                            Content="故障复位"
                            Icon="{ui:SymbolIcon ArrowReset24}" />
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Caution"
                            Command="{Binding ViewModel.DisableVoltageCommand}"
                            Content="断电压"
                            Icon="{ui:SymbolIcon Power24}" />
                        <ui:Button
                            MinWidth="118"
                            Height="38"
                            Margin="0,0,10,10"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.ShutdownCommand}"
                            Content="停机准备"
                            Icon="{ui:SymbolIcon ArrowExit20}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.ControlVm.OperationStatusText}" />
                    </StackPanel>
                </Expander>
            </ui:Card>

            <ui:Card Margin="0,12,0,0" Padding="16">
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="实时回传" />
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                    <WrapPanel>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="状态字" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.StatusWordHex}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="控制字" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.ControlWordHex}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CiA402 状态" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.ParsedStateName}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模式显示 0x6061" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.ModeDisplayName}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="实际位置 0x6064" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.PositionActual}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="实际速度 0x606C" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.VelocityActual}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="实际转矩 0x6077" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.TorqueActual}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TelemetryCellStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="错误代码 0x603F" />
                                <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding ViewModel.ErrorCode, StringFormat=0x{0:X4}}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    </StackPanel>
                </Expander>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
