<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>applicationIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);SA1601</NoWarn>
  </PropertyGroup>

  <!-- servoStudio 独立版本号（从 version.txt 读取） -->
  <Target Name="ReadVersionFile" BeforeTargets="IncrementVersion;BeforeBuild">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\version.txt">
      <Output TaskParameter="Lines" PropertyName="StudioVersionFromFile" />
    </ReadLinesFromFile>
  </Target>

  <Target Name="IncrementVersion" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\increment-version.ps1&quot; -Configuration $(Configuration) -VersionFile &quot;$(MSBuildProjectDirectory)\version.txt&quot;" />
    <!-- 重新读取更新后的版本 -->
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\version.txt">
      <Output TaskParameter="Lines" PropertyName="StudioVersion" />
    </ReadLinesFromFile>
    <Message Text="servoStudio version: $(StudioVersion)" Importance="high" />
    <!-- 将版本写入程序集 -->
    <CreateProperty Value="$(StudioVersion)">
      <Output TaskParameter="Value" PropertyName="Version" />
    </CreateProperty>
    <CreateProperty Value="$(StudioVersion)">
      <Output TaskParameter="Value" PropertyName="AssemblyVersion" />
    </CreateProperty>
    <CreateProperty Value="$(StudioVersion)">
      <Output TaskParameter="Value" PropertyName="FileVersion" />
    </CreateProperty>
    <CreateProperty Value="$(StudioVersion)">
      <Output TaskParameter="Value" PropertyName="InformationalVersion" />
    </CreateProperty>
  </Target>

  <ItemGroup>
    <Content Include="applicationIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AUTD3Sharp.Link.SOEM" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="CalcBinding" />
    <PackageReference Include="Leal.Core" />
    <PackageReference Include="Leal.Core.CANOpen.CiA402" />
    <PackageReference Include="Leal.Core.Machine.EtherCAT" />
    <PackageReference Include="Leal.Core.Net.EtherCAT" />
    <PackageReference Include="Leal.Core.Net.Modbus" />
    <PackageReference Include="Leal.Core.UI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="RJCP.SerialPortStream" />
    <PackageReference Include="ScottPlot" />
    <PackageReference Include="ScottPlot.WPF" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\applicationIcon-1024.png" />
    <None Remove="Assets\applicationIcon-256.png" />
    <None Remove="Assets\MotorSpin.png" />
    <None Remove="Assets\MotorSpinCCW.png" />
    <None Remove="Assets\MotorSpinCW.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wpf.Ui.DependencyInjection\Wpf.Ui.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Wpf.Ui.ToastNotifications\Wpf.Ui.ToastNotifications.csproj" />
    <ProjectReference Include="..\..\src\Wpf.Ui.Tray\Wpf.Ui.Tray.csproj" />
    <ProjectReference Include="..\..\src\Wpf.Ui\Wpf.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\applicationIcon-1024.png" />
    <Resource Include="Assets\applicationIcon-256.png" />
    <Resource Include="Assets\MotorSpin.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\MotorSpinCCW.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\MotorSpinCW.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ViewModels\AppData\" />
    <Folder Include="Views\Pages\AppDataPages\" />
  </ItemGroup>

  <!-- CAN 厂家原生库与配套配置：保持 native\can\<vendor>\ 子目录结构拷贝到输出目录。
       ZLG zlgcan 不只需要 DLL，还依赖 kerneldlls\dll_cfg.ini、*.xml、devices_property\ 等文件。 -->
  <ItemGroup>
    <None Include="native\can\**\*.*" CopyToOutputDirectory="PreserveNewest">
      <Link>native\can\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- OTA 打包工具: 每次生成时将 Models\ota_pack_tool 完整复制到输出目录，并清理临时文件 -->
  <Target Name="CopyOtaPackTool" AfterTargets="Build">
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\Models\ota_pack_tool&quot; &quot;$(OutputPath)ota_pack_tool&quot; /MIR /NJH /NJS /NP /NFL /NDL" IgnoreExitCode="true" />
    <Delete Files="$(OutputPath)ota_pack_tool\demo.bin" Condition="Exists('$(OutputPath)ota_pack_tool\demo.bin')" />
    <Delete Files="$(OutputPath)ota_pack_tool\update_sign.bin" Condition="Exists('$(OutputPath)ota_pack_tool\update_sign.bin')" />
  </Target>

</Project>
