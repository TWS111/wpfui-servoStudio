<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.HardwarePages.StoConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.HardwarePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="StoConfigPage"
    d:DataContext="{d:DesignInstance local:StoConfigPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="820"
    d:DesignWidth="960"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- 页标题 + 操作按钮 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="STO 安全配置" />
                    <TextBlock Margin="0,4,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="双通道安全转矩关闭 (STO) / 安全停机 1 (SS1) — IEC 61800-5-2。修改后需执行 H0D.03 参数存储。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,8,0" Content="读取全部" Command="{Binding ViewModel.ReadAllCommand}"
                               Icon="{ui:SymbolIcon ArrowDownload24}" MinWidth="110" />
                    <ui:Button Appearance="Primary" Content="写入全部" Command="{Binding ViewModel.WriteAllCommand}"
                               Icon="{ui:SymbolIcon ArrowUpload24}" MinWidth="110" />
                </StackPanel>
            </Grid>

            <!-- ═══════ 实时状态监视（只读） ═══════ -->
            <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Text="实时状态监视（只读）" />
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- STO_A 指示灯 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="STO_A 通道" />
                        <Border Width="36" Height="36" Margin="0,6,0,6" CornerRadius="18" HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFDD3333" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.StoAOk}" Value="True">
                                            <Setter Property="Background" Value="#FF4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontFamily="Consolas"
                                   Text="{Binding ViewModel.StoAChannelState}" />
                    </StackPanel>

                    <!-- STO_B 指示灯 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="STO_B 通道" />
                        <Border Width="36" Height="36" Margin="0,6,0,6" CornerRadius="18" HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFDD3333" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.StoBOk}" Value="True">
                                            <Setter Property="Background" Value="#FF4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontFamily="Consolas"
                                   Text="{Binding ViewModel.StoBChannelState}" />
                    </StackPanel>

                    <!-- STO 激活状态 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="STO 激活" />
                        <Border Width="36" Height="36" Margin="0,6,0,6" CornerRadius="18" HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#55888888" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.StoActive}" Value="True">
                                            <Setter Property="Background" Value="#FFDD3333" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="11"
                                   Text="{Binding ViewModel.StoActive, StringFormat='{}{0}'}" />
                    </StackPanel>

                    <!-- SS1 序列状态 -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SS1 序列" />
                        <Border Width="36" Height="36" Margin="0,6,0,6" CornerRadius="18" HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#55888888" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.Ss1Active}" Value="True">
                                            <Setter Property="Background" Value="#FFFFAA00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="11"
                                   Text="{Binding ViewModel.Ss1Active, StringFormat='{}{0}'}" />
                    </StackPanel>

                    <!-- H0F.13 状态字 -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="H0F.13 状态字" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                   Text="{Binding ViewModel.SafetyStatusWord}" />
                    </StackPanel>

                    <!-- 通道说明 -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Bit0 = STO_A&#x0a;Bit1 = STO_B&#x0a;Bit2 = STO激活&#x0a;Bit3 = SS1进行中" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ═══════ STO 基本配置 ═══════ -->
            <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Text="STO 基本配置 (H0F.10 ~ H0F.11, H0F.19)" />
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="200" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" MinWidth="200" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.10 STO 功能使能:" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" Content="启用 STO 安全转矩关闭功能"
                              IsChecked="{Binding ViewModel.StoEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.11 STO 故障响应:" />
                    <ComboBox Grid.Row="0" Grid.Column="4" Margin="0,6,0,6"
                              SelectedIndex="{Binding ViewModel.StoFaultAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="0 — 警告（不停机）" />
                        <ComboBoxItem Content="1 — 减速停机" />
                        <ComboBoxItem Content="2 — 立即报警停机" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.19 STO 复位方式:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6"
                              SelectedIndex="{Binding ViewModel.StoResetMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="0 — 自动复位（故障消除后自动恢复）" />
                        <ComboBoxItem Content="1 — 手动复位（需外部 DI 触发）" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.16 双通道不一致故障延时 (ms):" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="4" Margin="0,6,0,6"
                                  Minimum="0" Maximum="65535"
                                  ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  Value="{Binding ViewModel.StoDiscrepancyMs, UpdateSourceTrigger=LostFocus}" />
                </Grid>
            </ui:Card>

            <!-- ═══════ SS1 配置 ═══════ -->
            <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Text="SS1 安全停机配置 (H0F.12, H0F.17 ~ H0F.18)" />
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="200" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" MinWidth="200" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.12 SS1 停机延迟时间 (ms):" />
                    <ui:NumberBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6"
                                  Minimum="0" Maximum="65535"
                                  ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  Value="{Binding ViewModel.Ss1DelayMs, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.17 SS1 制动模式:" />
                    <ComboBox Grid.Row="0" Grid.Column="4" Margin="0,6,0,6"
                              SelectedIndex="{Binding ViewModel.Ss1BrakeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="0 — 自由停车（立即撤除转矩）" />
                        <ComboBoxItem Content="1 — 减速停机（按斜率减速后停车）" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" VerticalAlignment="Center"
                               Text="H0F.18 SS1 减速斜率 (rpm/s):" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6"
                                  Minimum="0" Maximum="65535"
                                  ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  Value="{Binding ViewModel.Ss1DecelRate, UpdateSourceTrigger=LostFocus}" />

                    <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="SS1 序列：STO 触发 → 等待延迟（H0F.12）→ 若制动模式=1则以斜率（H0F.18）减速 → 速度归零后关闭转矩。" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 状态栏 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ViewModel.StatusText}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
