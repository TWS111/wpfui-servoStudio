<Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.FirmwarePages.FactoryFirmwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.FirmwarePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FactoryFirmwarePage"
    d:DataContext="{d:DesignInstance local:FactoryFirmwarePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- 状态彩色徽章样式：根据 Status 值切换不同背景色/边框色。
             文字颜色使用主题感知的 TextFillColorPrimaryBrush，
             保证在亮/暗主题下均可读。背景使用半透明色叠加在主题底色上。 -->
        <Style x:Key="FirmwareStatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <!-- 默认（未签名）：灰 -->
            <Setter Property="Background" Value="#339E9E9E"/>
            <Setter Property="BorderBrush" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="仅签名">
                    <!-- 调色介于未签名（灰）与未注册（靖蓝）之间 -->
                    <Setter Property="Background" Value="#33607D8B"/>
                    <Setter Property="BorderBrush" Value="#78909C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="未注册">
                    <!-- 靖蓝色，与未签名（灰）明显拉开 -->
                    <Setter Property="Background" Value="#445C6BC0"/>
                    <Setter Property="BorderBrush" Value="#7986CB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="待测试">
                    <Setter Property="Background" Value="#332196F3"/>
                    <Setter Property="BorderBrush" Value="#42A5F5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已知问题">
                    <Setter Property="Background" Value="#44FF9800"/>
                    <Setter Property="BorderBrush" Value="#FFB74D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过测试">
                    <!-- 青色，与发布（绿）明显拉开 -->
                    <Setter Property="Background" Value="#4400BCD4"/>
                    <Setter Property="BorderBrush" Value="#26C6DA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="发布">
                    <Setter Property="Background" Value="#442E7D32"/>
                    <Setter Property="BorderBrush" Value="#43A047"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="归档">
                    <Setter Property="Background" Value="#33795548"/>
                    <Setter Property="BorderBrush" Value="#A1887F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="测试用例">
                    <Setter Property="Background" Value="#339C27B0"/>
                    <Setter Property="BorderBrush" Value="#BA68C8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="禁用">
                    <Setter Property="Background" Value="#44B71C1C"/>
                    <Setter Property="BorderBrush" Value="#E57373"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid x:Name="FactoryFirmwareContentRoot" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════ 网络状态 ══════ -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="厂家固件数据库"/>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="数据库路径:"/>
                            <TextBlock Text="{Binding ViewModel.DatabaseRootPath}" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="网络状态:"/>
                            <TextBlock Text="已连接公司网络"
                                       Foreground="#2E7D32" FontWeight="SemiBold"
                                       Visibility="{Binding ViewModel.IsCompanyNetworkAvailable, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="未连接公司网络"
                                       Foreground="#C62828" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsCompanyNetworkAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               VerticalAlignment="Center"
                               Command="{Binding ViewModel.RefreshNetworkCommand}"
                               Content="刷新网络状态"
                               Icon="{ui:SymbolIcon ArrowSync24}"/>
                </Grid>
            </ui:Card>

            <!-- ══════ 上传卡片（仅在公司网络可用时显示） ══════ -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12"
                     Visibility="{Binding ViewModel.IsCompanyNetworkAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="上传固件文件"/>

                    <!-- 选择文件 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.BrowseFileCommand}"
                                   Content="选择文件"
                                   Icon="{ui:SymbolIcon FolderOpen24}"/>
                        <ui:TextBox Grid.Column="1" Margin="10,0,10,0"
                                    IsReadOnly="True"
                                    PlaceholderText="尚未选择文件..."
                                    Text="{Binding ViewModel.SelectedFilePath, Mode=OneWay}"/>
                        <ui:Button Grid.Column="2"
                                   Command="{Binding ViewModel.ClearFileCommand}"
                                   Content="清除"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   IsEnabled="{Binding ViewModel.IsFileSelected}"/>
                    </Grid>

                    <!-- 元数据 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="版本号:"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"
                                    PlaceholderText="如 1.0.3"
                                    Text="{Binding ViewModel.VersionInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="名称:"/>
                        <ui:TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                                    PlaceholderText="固件显示名称"
                                    Text="{Binding ViewModel.NameInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="适用硬件版本:"/>
                        <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,16,8"
                                    PlaceholderText="如 HW-A2"
                                    Text="{Binding ViewModel.HardwareVersionInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="备注/描述:"/>
                        <ui:TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                                    PlaceholderText="可选"
                                    Text="{Binding ViewModel.DescriptionInput, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="状态:"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,16,8"
                                  HorizontalAlignment="Left" Width="180"
                                  ItemsSource="{Binding ViewModel.StatusOptions}"
                                  SelectedItem="{Binding ViewModel.SelectedStatus, Mode=TwoWay}"
                                  ToolTip="选择该固件的当前状态"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="产品类型:"/>
                        <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"
                                  HorizontalAlignment="Left" Width="180"
                                  ItemsSource="{Binding ViewModel.ProductTypeOptions}"
                                  SelectedItem="{Binding ViewModel.SelectedProductType, Mode=TwoWay}"
                                  ToolTip="选择该固件适用的产品类型（暂用 A/B/C 指代）"/>
                    </Grid>

                    <!-- 签名选项（互斥） -->
                    <Border Margin="0,4,0,0" Padding="10,8" CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Text="签名选项"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           Text="默认上传后状态为“未签名”，以下选项二选一。"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <CheckBox Margin="0,0,18,0"
                                          Content="先签名再上传 (pack_ota.py SHA256)"
                                          IsChecked="{Binding ViewModel.SignFirstBeforeUpload, Mode=TwoWay}"
                                          ToolTip="调用 pack_ota.py 生成签名产物，与原始文件一同存入数据库"/>
                                <CheckBox Content="已外部签名 (文件本身即为签名产物)"
                                          IsChecked="{Binding ViewModel.MarkExternallySignedOnUpload, Mode=TwoWay}"
                                          ToolTip="仅记录标记，不调用脚本，请确认该文件已经过等价签名处理"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 提交 -->
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary"
                                   Command="{Binding ViewModel.UploadCommand}"
                                   Content="上传到数据库"
                                   Icon="{ui:SymbolIcon CloudArrowUp24}"/>
                        <ui:ProgressRing Margin="12,0,0,0" Width="20" Height="20"
                                         IsIndeterminate="True"
                                         Visibility="{Binding ViewModel.IsUploading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding ViewModel.StatusText}"
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ══════ 操作密码验证卡片（单独区域） ══════ -->
            <ui:Card Grid.Row="2" Margin="0,0,0,12"
                     Visibility="{Binding ViewModel.IsCompanyNetworkAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" Text="操作密码验证"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Text="上传与删除均需在此输入并确认操作密码，验证通过后才可执行。上传或删除成功后需重新验证。"/>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="操作密码:"/>
                        <PasswordBox x:Name="OperationPasswordBox"
                                     Width="200"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     PasswordChanged="OperationPasswordBox_PasswordChanged"
                                     ToolTip="输入后点击“确认”进行验证"/>
                        <ui:Button Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Command="{Binding ViewModel.ConfirmPasswordCommand}"
                                   Content="确认"
                                   Icon="{ui:SymbolIcon Checkmark24}"/>
                        <ui:Button Command="{Binding ViewModel.ResetPasswordCommand}"
                                   Content="重置"
                                   Icon="{ui:SymbolIcon ArrowReset24}"
                                   ToolTip="清空密码并取消已验证状态"/>

                        <!-- 验证状态提示 -->
                        <Border Margin="16,0,0,0" Padding="10,4" CornerRadius="12"
                                VerticalAlignment="Center"
                                Background="#1F2E7D32"
                                BorderBrush="#2E7D32"
                                BorderThickness="1"
                                Visibility="{Binding ViewModel.IsPasswordConfirmed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14"
                                               Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           Text="已验证，可执行上传/删除"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="16,0,0,0" Padding="10,4" CornerRadius="12"
                                VerticalAlignment="Center"
                                Background="#1FC62828"
                                BorderBrush="#C62828"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.IsPasswordConfirmed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="14"
                                               Foreground="#C62828" VerticalAlignment="Center"/>
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#C62828"
                                           Text="未验证，上传与删除均不可用"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ══════ 已上传列表 ══════ -->
            <ui:Card Grid.Row="3"
                     Visibility="{Binding ViewModel.IsCompanyNetworkAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="488*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Text="数据库内已存放的固件" Grid.ColumnSpan="2"/>
                    <ui:DataGrid
                                 IsReadOnly="True"
                                 AutoGenerateColumns="False"
                                 FrozenColumnCount="1"
                                 ItemsSource="{Binding ViewModel.Entries}" Grid.ColumnSpan="2" Margin="0,27,0,0" Grid.RowSpan="2">
                        <ui:DataGrid.Columns>
                            <!-- 操作列：移至最左侧并冻结，使其在水平滚动时始终可见。
                                 Width=Auto 自适应内容宽度，刚好容纳两个按钮；CanUserResize=False 锁定宽度。
                                 通过 CellStyle/HeaderStyle 在右侧添加加粗分隔线，强化冻结边界。 -->
                            <!--
                                操作列：使用单一下拉按钮聚合所有可用操作，便于后续扩展更多操作而不挤占列宽。
                                各 MenuItem 通过自身 Command/CommandParameter 绑定 ViewModel；
                                "签名"/"标记外部签名" 类型动作的可用性与文案随条目状态切换。
                            -->
                            <DataGridTemplateColumn Header="操作"
                                                    Width="120"
                                                    CanUserReorder="False"
                                                    CanUserResize="False"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--
                                            DropDownButton：显式指定主题感知的前景色，避免在暗色模式下按钮内容（图标 + “操作”文字）
                                            渲染为白色与按钮自身浅色背景重叠造成不可读。
                                            Appearance=Secondary 让按钮在浅/深色主题下都使用对应的次要按钮配色。
                                        -->
                                        <ui:DropDownButton Margin="4,2,8,2"
                                                           Padding="8,3"
                                                           VerticalAlignment="Center"
                                                           Appearance="Secondary"
                                                           Content="操作"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                           ToolTip="该条目可执行的操作">
                                            <ui:DropDownButton.Flyout>
                                                <ContextMenu>
                                                    <!-- 签名：仅未签名且已注册条目可用 -->
                                                    <!--
                                                        ContextMenu 位于独立的 Popup 视觉树外，无法通过 AncestorType=Page 找到 Page。
                                                        改用 x:Reference page 直接引用（Page 上 x:Name="page"），避免命令绑定失效。
                                                    -->
                                                    <!--
                                                        烧录：仅"已注册 + 已签名"（即"仅签名"及以上状态）的条目可见。
                                                        未签名 / 未注册条目隐藏；不要求密码确认（烧录不改动数据库）。
                                                    -->
                                                    <MenuItem Header="烧录"
                                                              Icon="{ui:SymbolIcon ArrowUpload24}"
                                                              ToolTip="跳转到 FoE 固件烧录页并自动加载该条目（仅 .bin 文件可烧录）"
                                                              Command="{Binding ViewModel.BurnCommand, Source={x:Reference page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>

                                                    <Separator>
                                                        <Separator.Style>
                                                            <Style TargetType="Separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <!-- 与"烧录"项同步：仅在烧录可见时显示分割线 -->
                                                                    <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Separator.Style>
                                                    </Separator>

                                                    <MenuItem Header="签名 (pack_ota.py)"
                                                              Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                                              ToolTip="运行 pack_ota.py 对本条目进行签名（仅未签名且已注册条目可用）"
                                                              Command="{Binding ViewModel.SignCommand, Source={x:Reference page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSigned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <!-- 未注册条目禁止签名 -->
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>

                                                    <!-- 标记 / 取消 外部签名：脚本签名过的或未注册的条目不显示 -->
                                                    <MenuItem Icon="{ui:SymbolIcon Tag24}"
                                                              ToolTip="手动标记本文件已在外部签名过（或取消该标记）"
                                                              Command="{Binding ViewModel.ToggleExternalSignedCommand, Source={x:Reference page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Header" Value="标记为外部已签名"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExternallySigned}" Value="True">
                                                                        <Setter Property="Header" Value="取消外部已签名标记"/>
                                                                    </DataTrigger>
                                                                    <!-- 已通过脚本签名的条目不显示该菜单项 -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsSigned}" Value="True"/>
                                                                            <Condition Binding="{Binding IsExternallySigned}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                    <!-- 未注册条目禁止修改外部签名标记 -->
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>

                                                    <Separator>
                                                        <Separator.Style>
                                                            <Style TargetType="Separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Separator.Style>
                                                    </Separator>

                                                    <MenuItem Header="修改状态..."
                                                              Icon="{ui:SymbolIcon Edit24}"
                                                              ToolTip="仅修改该条目的状态（需先验证密码、该条目已签名且已注册）"
                                                              Command="{Binding ViewModel.EditStatusCommand, Source={x:Reference page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <!-- 未注册条目禁止修改状态 -->
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                    </MenuItem>

                                                    <Separator>
                                                        <Separator.Style>
                                                            <Style TargetType="Separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Separator.Style>
                                                    </Separator>

                                                    <MenuItem Header="删除"
                                                              Icon="{ui:SymbolIcon Delete24}"
                                                              ToolTip="从数据库删除此条目（需验证密码）"
                                                              Command="{Binding ViewModel.DeleteCommand, Source={x:Reference page}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Foreground>
                                                            <SolidColorBrush Color="#C62828"/>
                                                        </MenuItem.Foreground>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </ui:DropDownButton.Flyout>
                                        </ui:DropDownButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="上传时间" Width="165"
                                                Binding="{Binding UploadedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                            <DataGridTextColumn Header="名称" Width="150" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="产品类型" Width="90" Binding="{Binding ProductType}"/>
                            <DataGridTextColumn Header="版本号" Width="100" Binding="{Binding Version}"/>
                            <DataGridTemplateColumn Header="状态" Width="80" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FirmwareStatusBadge}">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 签名列业务上不对外展示：隐藏但保留定义以便后续调试/快速恢复 -->
                            <DataGridTextColumn Header="签名" Width="100" Binding="{Binding SignSourceText}" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="硬件版本" Width="100" Binding="{Binding ApplicableHardwareVersion}"/>
                            <DataGridTextColumn Header="原文件名" Width="150" Binding="{Binding OriginalFileName}"/>
                            <DataGridTextColumn Header="大小(字节)" Width="100" Binding="{Binding FileSizeBytes, StringFormat=N0}"/>
                            <DataGridTextColumn Header="上传者" Width="80" Binding="{Binding UploadedBy}"/>
                            <DataGridTextColumn Header="备注" Width="*" MinWidth="120" Binding="{Binding Description}"/>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </ui:Card>

            <!-- ══════ 未连接公司网络时的提示 ══════ -->
            <ui:Card Grid.Row="3" VerticalAlignment="Top">
                <ui:Card.Style>
                    <Style TargetType="ui:Card">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsCompanyNetworkAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <StackPanel HorizontalAlignment="Center" Margin="0,30,0,30">
                    <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="40"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold"
                               Text="未连接到公司网络"/>
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="请连接公司局域网/VPN后再使用厂家固件上传功能。"/>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!--
            加载蒙版：在异步检测公司网络 / 读取数据库索引期间显示，避免 UI 线程被 SMB 网络访问阻塞导致界面卡死。
            使用半透明背景 + 进度环 + 提示文本，覆盖整页且 IsHitTestVisible=True 拦截输入。
        -->
        <Border x:Name="LoadingOverlay"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="0.85"
                Panel.ZIndex="500"
                Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing Width="56" Height="56"
                                 IsIndeterminate="True"
                                 HorizontalAlignment="Center"/>
                <TextBlock Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="正在加载厂家固件数据库..."/>
                <TextBlock Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="检测公司网络并读取索引中，请稍候"/>
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding ViewModel.StatusText}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="520"/>
            </StackPanel>
        </Border>

        <!-- 未解锁厂家权限时的遮罩，阻止查看和交互 -->
        <Border x:Name="FactoryLockOverlay"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="0.97"
                Visibility="Collapsed"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LockClosed24"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="此页内容需要厂家权限"/>
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="请先到“设置”页输入正确的厂家密码解锁"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
