<Page x:Name="page"
    x:Class="Wpf.Ui.servoStudio.Views.Pages.MotionPages.MotionTypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.MotionPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MotionTypePage"
    d:DataContext="{d:DesignInstance local:MotionTypePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Grid x:Name="grid" Margin="20" 
          ShowGridLines="True"
          Width="{Binding ActualWidth, ElementName=page, Mode=OneWay}" 
          Height="{Binding ActualHeight, ElementName=page, Mode=OneWay}">

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Top" Width="{Binding ActualWidth, ElementName=grid, Mode=OneWay}">
            <TextBlock Text="控制模式："
                   Margin="0, 4, 0 ,0" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   FontSize="20"                   
                   />
            <ComboBox Width="200" Height="35" x:Name="name"
                ItemsSource="{Binding ViewModel.ComboBoxMotionMode, Mode=TwoWay}" 
                SelectedIndex="{Binding ViewModel.MotionModeIndex, Mode=OneWay}"
                Margin="120, 0, 0 ,0" 
                VerticalAlignment="Top"
                HorizontalAlignment="Left"/>
            <Button Width="120" Height="35" Content="设置到该模式"
                Margin="350, 0, 0 ,0" 
                VerticalAlignment="Top"
                HorizontalAlignment="Left"/>
        </Grid>
        <ui:DataGrid 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            Margin="0, 70, 0, 0" 
            IsReadOnly="False"
            ItemsSource="{Binding ViewModel.FactoryParametersCollection, Mode=TwoWay}">
        </ui:DataGrid>

    </Grid>
</Page>
