<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.DeviceSetPages.DeviceAddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.DeviceSetPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DeviceAddPage"
    d:DataContext="{d:DesignInstance local:DeviceAddPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="20,10,20,10">
        <TabControl>

            <!-- ===== EtherCAT ===== -->
            <TabItem IsSelected="True">
                <TabItem.Header>
                    <TextBlock Text="EtherCAT" FontSize="16"/>
                </TabItem.Header>
                <Grid Margin="30,20,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 网络适配器 -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="网络适配器：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              x:Name="ethernetDevices" Height="32"
                              ItemsSource="{Binding ViewModel.EthernetDeviceNames, Mode=OneWay}"
                              SelectedIndex="{Binding ViewModel.EthernetDeviceSelect, Mode=TwoWay}"
                              DropDownOpened="EthernetDevices_DropDownOpened"
                              VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <StackPanel Grid.Row="0" Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="5,5,5,5">
                        <ui:Button Content="选    择" Icon="Connector20"
                                   Height="32" MinWidth="100"
                                   Command="{Binding ViewModel.EthernetConfirmCommand, Mode=OneWay}"/>
                        <ui:Button Content="断    开" Icon="PlugDisconnected20"
                                   Height="32" MinWidth="100"
                                   Margin="6,0,0,0"
                                   Command="{Binding ViewModel.EthernetDisconnectCommand, Mode=OneWay}"/>
                        <Grid Margin="6,0,0,0" Width="30" Height="30">
                            <!-- 加载动画 -->
                            <ui:ProgressRing Visibility="{Binding ViewModel.IsEthernetLoadingVisible, Mode=OneWay}"
                                             Height="24" Width="24"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsIndeterminate="True" />

                            <Label Content="√" FontWeight="Bold" FontSize="28"
                                   Visibility="{Binding ViewModel.IsEthernetLinkSucceedVisible, Mode=OneWay}"
                                   Foreground="#9E006D55" FontFamily="Segoe UI Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Label Content="X" FontWeight="Bold" FontSize="28"
                                   Visibility="{Binding ViewModel.IsEthernetLinkFailedVisible, Mode=OneWay}"
                                   Foreground="#CCFC0A0A" FontFamily="Segoe UI Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- Row 1: 以太网名称 -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="以太网名称：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Content="{Binding ViewModel.SelectedEthernetName, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>

                    <!-- Row 2: 从站信息 -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="从站信息：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding ViewModel.EthernetSlaveInfo, Mode=OneWay}"
                               FontSize="15" Foreground="gray"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="5,5,5,5"/>

                    <!-- Row 3: 从站名称 -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="从站名称：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                           Content="{Binding ViewModel.EthernetSlaveNameInfo, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <!-- Row 4: 从站地址 -->
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="从站地址：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                           Content="{Binding ViewModel.EthernetSlaveAddrInfo, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <!-- Row 5: 从站状态 -->
                    <Label Grid.Row="5" Grid.Column="0"
                           Content="从站状态：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <Label Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                           Content="{Binding ViewModel.EthernetSlaveStateInfo, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <!-- Row 6: 状态文本 -->
                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding ViewModel.EthernetStatusText, Mode=OneWay}"
                               FontSize="15" Foreground="Gray"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="5,5,5,5"/>
                    <!-- Row 7: 手动状态切换 -->
                    <Label Grid.Row="7" Grid.Column="0"
                           Content="手动状态切换：" FontSize="16" Foreground="Black"
                           VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="5,5,5,5">
                        <ui:Button Content="INIT"
                                   Height="32" MinWidth="80"
                                   Command="{Binding ViewModel.NmtSwitchToInitCommand, Mode=OneWay}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ViewModel.EthernetSlaveStateInfo}" Value="Init">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="PreOP"
                                   Height="32" MinWidth="80" Margin="6,0,0,0"
                                   Command="{Binding ViewModel.NmtSwitchToPreOPCommand, Mode=OneWay}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ViewModel.EthernetSlaveStateInfo}" Value="PreOperational">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="SafeOP"
                                   Height="32" MinWidth="80" Margin="6,0,0,0"
                                   Command="{Binding ViewModel.NmtSwitchToSafeOPCommand, Mode=OneWay}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ViewModel.EthernetSlaveStateInfo}" Value="SafeOperational">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="OP"
                                   Height="32" MinWidth="80" Margin="6,0,0,0"
                                   Command="{Binding ViewModel.NmtSwitchToOPCommand, Mode=OneWay}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding ViewModel.EthernetSlaveStateInfo}" Value="Operational">
                                            <Setter Property="Appearance" Value="Primary"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>

                </Grid>
            </TabItem>

            <!-- ===== CANopen ===== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="CANopen" FontSize="16"/>
                </TabItem.Header>
                <Grid Margin="30,20,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 串口（USB-CAN 适配器） -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="USB-CAN 串口：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxPortNameFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxPortNameSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,0,10">
                        <ui:Button Content="连接 CANopen" Icon="Connector20"
                                   Height="32" MinWidth="120"
                                   Command="{Binding ViewModel.CanOpenConnectCommand, Mode=OneWay}"/>
                        <ui:Button Content="断开" Icon="PlugDisconnected20"
                                   Height="32" MinWidth="80" Margin="6,0,0,0"
                                   Command="{Binding ViewModel.CanOpenDisconnectCommand, Mode=OneWay}"/>
                        <Label Content="√" FontWeight="Bold" FontSize="22"
                               Visibility="{Binding ViewModel.IsCanopenConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Hidden}"
                               Foreground="#9E006D55" FontFamily="Segoe UI Black"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Row 1: 比特率 -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="比特率：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxCanBitrateFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxCanBitrateSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>

                    <!-- Row 2: Node ID -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="节点地址 (1~127)：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ui:NumberBox Grid.Row="2" Grid.Column="1"
                                  Height="32"
                                  Minimum="1" Maximum="127"
                                  Value="{Binding ViewModel.CanopenNodeId, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,10"/>

                    <!-- Row 3: 节点名称 -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="节点名称：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                           Content="{Binding ViewModel.CanopenSlaveNameInfo, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Row 4: 软件版本 -->
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="软件版本：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <Label Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                           Content="{Binding ViewModel.CanopenFirmwareInfo, Mode=OneWay}"
                           Foreground="#FF0066CC" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Row 5: 状态文本 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="{Binding ViewModel.CanopenStatusText, Mode=OneWay}"
                               FontSize="14" Foreground="Gray"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <!-- ===== Modbus ===== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Modbus" FontSize="16"/>
                </TabItem.Header>
                <Grid Margin="30,20,30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 串口号 -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="串口号：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              x:Name="name" Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxPortNameFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxPortNameSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <StackPanel Grid.Row="0" Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,0,10">
                        <ui:Button Content="连接串口设备" Icon="Connector20"
                                   Height="32" MinWidth="120"
                                   Command="{Binding ViewModel.DeviceConnectCommand, Mode=OneWay}"
                                   CommandParameter="{x:Type local:ListPage}"/>
                        <Label Content="√" FontWeight="Bold" FontSize="28"
                               Visibility="{Binding ViewModel.IsLinkSucceedVisible, Mode=OneWay}"
                               Foreground="#9E006D55" FontFamily="Segoe UI Black"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Label Content="X" FontWeight="Bold" FontSize="28"
                               Visibility="{Binding ViewModel.IsLinkFailedVisible, Mode=OneWay}"
                               Foreground="#CCFC0A0A" FontFamily="Segoe UI Black"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Row="0" Grid.Column="3"
                                 IsIndeterminate="False"
                                 Height="6" Width="100"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ViewModel.ProgressbarValue}"
                                 VerticalAlignment="Center" Margin="8,0,0,10"/>

                    <!-- Row 1: 波特率 -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="波特率：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              x:Name="baud" Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxBaudFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxBaudSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>

                    <!-- Row 2: 数据位 -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="数据位：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              x:Name="databit" Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxDataBitFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxDataBitSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>

                    <!-- Row 3: 校验位 -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="校验位：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              x:Name="checkbit" Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxCheckBitFamilies, Mode=TwoWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxCheckBitSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>

                    <!-- Row 4: 停止位 -->
                    <Label Grid.Row="4" Grid.Column="0"
                           Content="停止位：" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,8,10"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              x:Name="stopbit" Height="32"
                              ItemsSource="{Binding ViewModel.ComboBoxStopBitFamilies, Mode=OneWay}"
                              SelectedIndex="{Binding ViewModel.ComboBoxStopBitSelect, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,10"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>