<Page
    x:Class="Wpf.Ui.servoStudio.Views.Pages.HardwarePages.MotorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.servoStudio.Views.Pages.HardwarePages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Wpf.Ui.servoStudio.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="电机参数"
    d:DataContext="{d:DesignInstance local:MotorPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="ReadOnlyRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background" Value="#1AFF8C00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadSuccess}" Value="True">
                    <Setter Property="Fill" Value="#FF00CC66"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- 连接状态栏 -->
            <Border Margin="0,0,0,12" Padding="14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{DynamicResource TextFillColorDisabledBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#FF00CC66"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ViewModel.ConnectionInfo}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ViewModel.StatusText}" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DockPanel>
            </Border>

            <!-- 工具栏 -->
            <ui:Card Margin="0,0,0,12" Padding="12">
                <WrapPanel HorizontalAlignment="Center">
                    <ui:Button Content="读取全部参数" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Margin="4" Width="160"
                               Command="{Binding ViewModel.ReadAllParametersCommand}"
                               IsEnabled="{Binding ViewModel.IsConnected}"/>
                    <ui:Button Content="写入已修改参数" Icon="{ui:SymbolIcon ArrowUpload24}"
                               Margin="4" Width="160"
                               Appearance="Primary"
                               Command="{Binding ViewModel.WriteModifiedParametersCommand}"
                               IsEnabled="{Binding ViewModel.IsConnected}"/>
                    <ui:Button Content="刷新监视参数" Icon="{ui:SymbolIcon ArrowSync24}"
                               Margin="4" Width="160"
                               Command="{Binding ViewModel.RefreshMonitorParametersCommand}"
                               IsEnabled="{Binding ViewModel.IsConnected}"/>
                    <ui:Button Margin="4" Width="160"
                               Command="{Binding ViewModel.ToggleAutoMonitorCommand}"
                               IsEnabled="{Binding ViewModel.IsConnected}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="开启自动监视"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewModel.IsAutoMonitoring}" Value="True">
                                                    <Setter Property="Text" Value="停止自动监视"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:Button Content="放弃所有修改" Icon="{ui:SymbolIcon Dismiss24}"
                               Margin="4" Width="160"
                               Command="{Binding ViewModel.DiscardAllChangesCommand}"/>
                </WrapPanel>
            </ui:Card>

            <!-- 进度条 -->
            <ProgressBar Margin="0,0,0,8" Height="4"
                         Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibility}}"
                         Minimum="0"
                         Maximum="{Binding ViewModel.ReadTotal}"
                         Value="{Binding ViewModel.ReadProgress}"/>

            <!-- 参数表格 -->
            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      RowStyle="{StaticResource ReadOnlyRowStyle}"
                      FontSize="15"
                      ColumnHeaderHeight="38"
                      RowHeight="42"
                      ItemsSource="{Binding ViewModel.HardwareControllerCollection}"
                      MinHeight="400"
                      MaxHeight="600"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <!-- 状态指示 -->
                    <DataGridTemplateColumn Header="" Width="30" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Style="{StaticResource StatusIndicator}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- H索引 -->
                    <DataGridTextColumn Header="H索引" Width="90" IsReadOnly="True"
                                        Binding="{Binding Index}"/>

                    <!-- 通信地址 -->
                    <DataGridTextColumn Header="通信地址" Width="110" IsReadOnly="True"
                                        Binding="{Binding CommAddress}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 参数名称 -->
                    <DataGridTextColumn Header="参数名称" Width="*" IsReadOnly="True"
                                        Binding="{Binding Name}"/>

                    <!-- 当前值 (可编辑) -->
                    <DataGridTextColumn Header="当前值" Width="110"
                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- 单位 -->
                    <DataGridTextColumn Header="单位" Width="70" IsReadOnly="True"
                                        Binding="{Binding Unit}"/>

                    <!-- 最小值 -->
                    <DataGridTextColumn Header="最小值" Width="80" IsReadOnly="True"
                                        Binding="{Binding Min}"/>

                    <!-- 最大值 -->
                    <DataGridTextColumn Header="最大值" Width="80" IsReadOnly="True"
                                        Binding="{Binding Max}"/>

                    <!-- 默认值 -->
                    <DataGridTextColumn Header="默认值" Width="80" IsReadOnly="True"
                                        Binding="{Binding DefaultValue}"/>

                    <!-- R/W 标记 -->
                    <DataGridTemplateColumn Header="R/W" Width="55" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="R/W"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                    <Setter Property="Text" Value="R"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 写入按钮 -->
                    <DataGridTemplateColumn Header="操作" Width="70" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="写入" Padding="8,4" FontSize="14"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.ViewModel.WriteSingleParameterCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</Page>
